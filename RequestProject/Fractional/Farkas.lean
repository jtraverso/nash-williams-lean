import Mathlib

/-!
# Farkas' lemma for finitely many vectors in `κ → ℝ`

We prove that a finitely generated cone is closed (by Carathéodory-type reduction to linearly
independent generators) and deduce Farkas' lemma from the Hahn–Banach separation theorem.
-/

namespace NashWilliams.Frac

open Finset

variable {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ]

/-- The cone generated by the vectors `A i`, `i ∈ s`. -/
def coneOn (A : ι → κ → ℝ) (s : Finset ι) : Set (κ → ℝ) :=
  {z | ∃ x : ι → ℝ, (∀ i, 0 ≤ x i) ∧ z = ∑ i ∈ s, x i • A i}

omit [Fintype ι] [Fintype κ] in
lemma coneOn_erase_subset (A : ι → κ → ℝ) (s : Finset ι) (j : ι) :
    coneOn A (s.erase j) ⊆ coneOn A s := by
  rintro z ⟨x, hx, rfl⟩
  refine ⟨fun i => if i = j then 0 else x i, fun i => by dsimp only; split_ifs <;> simp [hx i],
    ?_⟩
  by_cases hj : j ∈ s
  · rw [← sum_erase_add _ _ hj]
    simp only [if_true, zero_smul, add_zero]
    exact sum_congr rfl fun i hi => by simp [ne_of_mem_erase hi]
  · rw [erase_eq_of_notMem hj]
    exact sum_congr rfl fun i hi => by
      have : i ≠ j := by rintro rfl; exact hj hi
      simp [this]

omit [Fintype κ] in
/-- Linearly independent generators: the cone is the image of the closed orthant under an
injective linear map, hence closed. -/
lemma coneOn_closed_of_li (A : ι → κ → ℝ) (s : Finset ι)
    (hli : LinearIndependent ℝ (fun i : s => A i)) : IsClosed (coneOn A s) := by
  set L := Fintype.linearCombination ℝ (fun i : s => A i)
  have hinj : LinearMap.ker L = ⊥ :=
    LinearMap.ker_eq_bot.2 (linearIndependent_iff_injective_fintypeLinearCombination.1 hli)
  have hemb := LinearMap.isClosedEmbedding_of_injective hinj
  have hset : coneOn A s = L '' {y | ∀ i, 0 ≤ y i} := by
    ext z
    constructor
    · rintro ⟨x, hx, rfl⟩
      refine ⟨fun i => x i, fun i => hx i, ?_⟩
      simp only [L, Fintype.linearCombination_apply]
      exact sum_coe_sort s (fun i => x i • A i)
    · rintro ⟨y, hy, rfl⟩
      refine ⟨fun i => if h : i ∈ s then y ⟨i, h⟩ else 0,
        fun i => by dsimp only; split_ifs with h; exacts [hy ⟨i, h⟩, le_rfl], ?_⟩
      simp only [L, Fintype.linearCombination_apply]
      rw [← sum_coe_sort s]
      refine sum_congr rfl fun i _ => ?_
      simp [i.2]
  have hcl : {y : s → ℝ | ∀ i, 0 ≤ y i} = ⋂ i, {y | 0 ≤ y i} := by ext; simp
  rw [hset, hcl]
  exact hemb.isClosedMap _ (isClosed_iInter fun i => isClosed_le continuous_const
    (continuous_apply i))

omit [Fintype ι] [Fintype κ] in
/-- A dependent family of generators: the cone is the union of the cones obtained by removing
one generator. -/
lemma coneOn_eq_biUnion (A : ι → κ → ℝ) (s : Finset ι)
    (hli : ¬LinearIndependent ℝ (fun i : s => A i)) :
    coneOn A s = ⋃ j ∈ s, coneOn A (s.erase j) := by
  apply Set.Subset.antisymm
  · obtain ⟨g0, hg0, i0, hi0⟩ := Fintype.not_linearIndependent_iff.1 hli
    -- choose a dependency with a positive coefficient
    obtain ⟨g, hg, i1, hi1⟩ : ∃ g : s → ℝ, ∑ i, g i • A i = 0 ∧ ∃ i, 0 < g i := by
      rcases hi0.lt_or_gt with h | h
      · refine ⟨fun i => -g0 i, ?_, i0, by simp; linarith⟩
        simp only [neg_smul, sum_neg_distrib, hg0, neg_zero]
      · exact ⟨g0, hg0, i0, h⟩
    set g' : ι → ℝ := fun i => if h : i ∈ s then g ⟨i, h⟩ else 0 with hg'
    have hg'sum : ∑ i ∈ s, g' i • A i = 0 := by
      rw [← hg, ← sum_coe_sort s]
      refine sum_congr rfl fun i _ => ?_
      simp [hg', i.2]
    rintro z ⟨x, hx, rfl⟩
    set P := s.filter (fun i => 0 < g' i)
    have hP : P.Nonempty := ⟨i1, by simp [P, hg', i1.2, hi1]⟩
    obtain ⟨j, hjP, hjmin⟩ := P.exists_min_image (fun i => x i / g' i) hP
    simp only [P, mem_filter] at hjP
    set t := x j / g' j
    have ht : 0 ≤ t := div_nonneg (hx j) hjP.2.le
    set x' : ι → ℝ := fun i => x i - t * g' i
    have hx' : ∀ i, 0 ≤ x' i := by
      intro i
      simp only [x']
      by_cases hi : i ∈ s
      · rcases le_or_gt (g' i) 0 with h | h
        · nlinarith [hx i]
        · have := hjmin i (by simp [P, hi, h])
          rw [le_div_iff₀ h] at this
          linarith
      · have : g' i = 0 := by simp [hg', hi]
        rw [this]; simp [hx i]
    have hx'j : x' j = 0 := by
      simp only [x', t]; rw [div_mul_cancel₀ _ hjP.2.ne']; ring
    refine Set.mem_biUnion hjP.1 ⟨x', hx', ?_⟩
    rw [sum_erase _ (by rw [hx'j, zero_smul])]
    simp only [x', sub_smul, sum_sub_distrib, mul_smul, ← smul_sum, hg'sum, smul_zero,
      sub_zero]
  · exact Set.iUnion₂_subset fun j _ => coneOn_erase_subset A s j

omit [Fintype κ] in
/-- Finitely generated cones are closed. -/
theorem coneOn_closed (A : ι → κ → ℝ) (s : Finset ι) : IsClosed (coneOn A s) := by
  induction s using Finset.strongInduction with
  | H s ih =>
    by_cases hli : LinearIndependent ℝ (fun i : s => A i)
    · exact coneOn_closed_of_li A s hli
    · rw [coneOn_eq_biUnion A s hli]
      exact isClosed_biUnion_finset fun j hj => ih _ (erase_ssubset hj)

omit [Fintype ι] [DecidableEq ι] [Fintype κ] in
lemma coneOn_convex (A : ι → κ → ℝ) (s : Finset ι) : Convex ℝ (coneOn A s) := by
  rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩ a b ha hb _
  refine ⟨fun i => a * x i + b * y i, fun i => by nlinarith [hx i, hy i], ?_⟩
  simp only [smul_sum, smul_smul, ← sum_add_distrib, add_smul]

/-- **Farkas' lemma**: if every `y` that is nonnegative on all the `A i` is nonnegative on `b`,
then `b` is a nonnegative combination of the `A i`. -/
theorem farkas (A : ι → κ → ℝ) (b : κ → ℝ)
    (h : ∀ y : κ → ℝ, (∀ i, 0 ≤ ∑ k, A i k * y k) → 0 ≤ ∑ k, b k * y k) :
    ∃ x : ι → ℝ, (∀ i, 0 ≤ x i) ∧ ∑ i, x i • A i = b := by
  by_contra hb
  have hbK : b ∉ coneOn A univ := by
    rintro ⟨x, hx, rfl⟩; exact hb ⟨x, hx, rfl⟩
  obtain ⟨f, u, hfu, hub⟩ :=
    geometric_hahn_banach_closed_point (coneOn_convex A univ) (coneOn_closed A univ) hbK
  have h0 : (0 : κ → ℝ) ∈ coneOn A univ := ⟨0, fun _ => le_rfl, by simp⟩
  have hu : 0 < u := by have := hfu 0 h0; simpa using this
  -- `f` is nonpositive on the generators
  have hfA : ∀ i, f (A i) ≤ 0 := by
    intro i
    by_contra hpos
    push_neg at hpos
    have hmem : (u / f (A i)) • A i ∈ coneOn A univ := by
      refine ⟨fun j => if j = i then u / f (A i) else 0, fun j => ?_, ?_⟩
      · dsimp only
        split_ifs
        · exact (div_pos hu hpos).le
        · exact le_rfl
      · simp
    have := hfu _ hmem
    rw [map_smul, smul_eq_mul, div_mul_cancel₀ _ hpos.ne'] at this
    exact lt_irrefl _ this
  classical
  have hrepr : ∀ z : κ → ℝ, f z = ∑ k, z k * f (Pi.single k 1) := by
    intro z
    conv_lhs => rw [show z = ∑ k, z k • (Pi.single k 1 : κ → ℝ) by
      ext j; simp [Pi.single_apply]]
    simp [map_sum, map_smul]
  have := h (fun k => -f (Pi.single k 1)) (fun i => by
    have := hrepr (A i)
    simp only [mul_neg, sum_neg_distrib]
    linarith [hfA i])
  have hb' := hrepr b
  simp only [mul_neg, sum_neg_distrib] at this
  linarith

end NashWilliams.Frac
