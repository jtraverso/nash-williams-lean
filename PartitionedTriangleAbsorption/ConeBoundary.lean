module

public import PartitionedTriangleAbsorption.HingeTemplate
public import PartitionedTriangleAbsorption.ReturnedBasic
public import Mathlib.Data.Fintype.Fin
public import Mathlib.Algebra.BigOperators.Pi
public import Mathlib.Algebra.Order.BigOperators.Group.Finset
public import Mathlib.Tactic.NormNum
public import Mathlib.Tactic.Ring
public import Mathlib.Tactic.Linarith

/-! # Removing an arbitrary decomposable set can cross a degree-cone boundary

Six physical vertices, two part labels, and permitted triangle types 112 and
122. This is a counterexample to an unrestricted residual-cone preservation
claim, not to Theorem 13.16. No regularity, abundance, or sparsity claim is made.
-/

@[expose] public section

namespace PartitionedTriangleAbsorption.ConeBoundary

open HingeTemplate

def part (v : Vertex) : Bool := decide (4 ≤ v.val)

def originalParts : Finset (Finset Edge) :=
  {triangle 0 1 4, triangle 0 2 5, triangle 3 4 5}

def originalEdges : Finset Edge := originalParts.biUnion id
def removedEdges : Finset Edge := triangle 0 4 5
def residualEdges : Finset Edge := originalEdges \ removedEdges

def degreeToPart (E : Finset Edge) (v : Vertex) (b : Bool) : ℕ :=
  ((Finset.univ : Finset Vertex).filter (fun w => part w = b ∧ s(v, w) ∈ E)).card

/-- Degree cone at a part-1 vertex: generated by (1,1) and (0,2). -/
def InDegreeCone (x y : ℝ) : Prop :=
  ∃ a b : ℝ, 0 ≤ a ∧ 0 ≤ b ∧ x = a ∧ y = a + 2 * b

theorem inDegreeCone_iff (x y : ℝ) : InDegreeCone x y ↔ 0 ≤ x ∧ x ≤ y := by
  constructor
  · rintro ⟨a, b, ha, hb, rfl, rfl⟩
    exact ⟨ha, le_add_of_nonneg_right (mul_nonneg (by norm_num) hb)⟩
  · rintro ⟨hx, hxy⟩
    refine ⟨x, (y - x) / 2, hx, div_nonneg (sub_nonneg.mpr hxy) (by norm_num), rfl, ?_⟩
    ring

/-- The correct local boundary condition for subtracting a degree vector.
Sparsity alone cannot replace the second, directional slack inequality. -/
theorem residual_cone_iff (x y u v : ℝ) :
    InDegreeCone (x - u) (y - v) ↔ u ≤ x ∧ v - u ≤ y - x := by
  rw [inDegreeCone_iff]
  constructor <;> rintro ⟨h₁, h₂⟩ <;> constructor <;> linarith

def partIndex (v : Vertex) : Fin 2 := if v.val < 4 then 0 else 1

def permittedFamily : Finset (Multiset (Fin 2)) := {{0, 0, 1}, {0, 1, 1}}

/-- An exact certificate in Aristotle's own typed decomposition interface. -/
theorem original_typed_decomposition :
    HasDecomp partIndex permittedFamily originalEdges := by
  refine ⟨{{0, 1, 4}, {0, 2, 5}, {3, 4, 5}}, ?_⟩
  change
    (∀ s ∈ ({{0, 1, 4}, {0, 2, 5}, {3, 4, 5}} : Finset (Finset Vertex)),
      s.card = 3 ∧ s.val.map partIndex ∈ permittedFamily) ∧
    (∀ s ∈ ({{0, 1, 4}, {0, 2, 5}, {3, 4, 5}} : Finset (Finset Vertex)),
      ∀ s' ∈ ({{0, 1, 4}, {0, 2, 5}, {3, 4, 5}} : Finset (Finset Vertex)),
        s ≠ s' → Disjoint (triEdges s) (triEdges s')) ∧
    ({{0, 1, 4}, {0, 2, 5}, {3, 4, 5}} : Finset (Finset Vertex)).biUnion triEdges =
      originalEdges
  decide

theorem removed_typed_decomposition : HasDecomp partIndex permittedFamily removedEdges := by
  refine ⟨{{0, 4, 5}}, ?_⟩
  change
    (∀ s ∈ ({{0, 4, 5}} : Finset (Finset Vertex)),
      s.card = 3 ∧ s.val.map partIndex ∈ permittedFamily) ∧
    (∀ s ∈ ({{0, 4, 5}} : Finset (Finset Vertex)),
      ∀ s' ∈ ({{0, 4, 5}} : Finset (Finset Vertex)),
        s ≠ s' → Disjoint (triEdges s) (triEdges s')) ∧
    ({{0, 4, 5}} : Finset (Finset Vertex)).biUnion triEdges = removedEdges
  decide

theorem removed_subset : removedEdges ⊆ originalEdges := by decide

/-- All four displayed triangles have one of the two permitted part types. -/
theorem permitted_types :
    (part 0, part 1, part 4) = (false, false, true) ∧
    (part 0, part 2, part 5) = (false, false, true) ∧
    (part 3, part 4, part 5) = (false, true, true) ∧
    (part 0, part 4, part 5) = (false, true, true) := by decide

theorem root_degree_vectors :
    degreeToPart originalEdges 0 false = 2 ∧ degreeToPart originalEdges 0 true = 2 ∧
    degreeToPart residualEdges 0 false = 2 ∧ degreeToPart residualEdges 0 true = 0 := by
  decide

theorem original_root_in_cone :
    InDegreeCone (degreeToPart originalEdges 0 false) (degreeToPart originalEdges 0 true) := by
  rw [root_degree_vectors.1, root_degree_vectors.2.1]
  exact ⟨2, 0, by norm_num, le_rfl, rfl, by norm_num⟩

theorem residual_root_not_in_cone :
    ¬ InDegreeCone (degreeToPart residualEdges 0 false) (degreeToPart residualEdges 0 true) := by
  rw [root_degree_vectors.2.2.1, root_degree_vectors.2.2.2]
  rintro ⟨a, b, _, hb, ha, hy⟩
  have hle : a ≤ a + 2 * b := le_add_of_nonneg_right (mul_nonneg (by norm_num) hb)
  rw [← hy, ← ha] at hle
  norm_num at hle

/-- The residual fails the actual fractional divisibility predicate from the return. -/
theorem residual_not_fractionally_divisible :
    ¬ IsFracDiv partIndex permittedFamily residualEdges := by
  rintro ⟨_, hvertices⟩
  obtain ⟨c, hc, heq⟩ := hvertices 0
  have hmono : ∀ τ ∈ permittedFamily,
      (typeDegVec τ (partIndex 0) 0 : ℝ) ≤ (typeDegVec τ (partIndex 0) 1 : ℝ) := by
    intro τ hτ
    simp only [permittedFamily, Finset.mem_insert, Finset.mem_singleton] at hτ
    rcases hτ with rfl | rfl <;> norm_num [typeDegVec, partIndex]
  have hle : (degVec partIndex residualEdges 0 0 : ℝ) ≤
      (degVec partIndex residualEdges 0 1 : ℝ) := by
    rw [congrFun heq 0, congrFun heq 1]
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    apply Finset.sum_le_sum
    intro τ hτ
    exact mul_le_mul_of_nonneg_left (hmono τ (Finset.mem_filter.mp hτ).1) (hc τ)
  have hzero : degVec partIndex residualEdges 0 0 = 2 := by decide
  have hone : degVec partIndex residualEdges 0 1 = 0 := by decide
  rw [hzero, hone] at hle
  norm_num at hle

end PartitionedTriangleAbsorption.ConeBoundary
