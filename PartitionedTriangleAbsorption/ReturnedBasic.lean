/-!
# Partitioned triangles: basic definitions (Delcourt–Postle, §13)

Definitions 13.1–13.15 of *A Proof of Nash-Williams' Conjecture* specialised to families of
partitioned triangles, as needed to state Theorem 13.16 (the special case of the
"refined absorption" decomposition theorem of reference [17]).

Conventions.
* A `t`-partition of the vertex type `V` is a map `p : V → Fin t` (vertex `v` lies in part `p v`).
* A partitioned triangle type `T_{ijk}` is the multiset `{i, j, k} : Multiset (Fin t)`
  (indices may repeat).  A family `F` is a `Finset` of such multisets.
* Since triangles of a simple graph are determined by their vertex sets, a copy of `T_{ijk}`
  is a 3-element vertex set `s` whose multiset of parts `s.val.map p` equals `{i, j, k}`.
* Graphs and their subgraphs are handled through edge sets `E : Finset (Sym2 V)`; an
  `F`-decomposition of `E` is a family of typed triangles whose edge sets partition `E`.
* Edge-count vectors are recorded with *ordered* pairs of parts: the entry `(i, j)` counts
  ordered pairs `(u, v)` with `uv ∈ E`, `p u = i`, `p v = j`.  This is an injective linear
  re-encoding of the paper's vector `(e_{ij} : i ≤ j)` (off-diagonal entries are duplicated and
  diagonal entries are doubled), so membership in lattices and cones is unchanged.
-/

@[expose] public section

namespace PartitionedTriangleAbsorption

open Finset

variable {V : Type*} [Fintype V] [DecidableEq V] {t : ℕ}

/-! ### Edge and degree vectors -/

/-- Contribution of a single edge to the (ordered) edge-count vector. -/
def pairVec (p : V → Fin t) (e : Sym2 V) : Fin t → Fin t → ℤ :=
  Sym2.lift ⟨fun u v i j => (if p u = i ∧ p v = j then 1 else 0) +
      (if p v = i ∧ p u = j then 1 else 0), by
    intro u v; funext i j; exact add_comm _ _⟩ e

/-- Contribution of a single edge to the degree vector of the vertex `v`. -/
def degContrib (p : V → Fin t) (v : V) (e : Sym2 V) : Fin t → ℤ :=
  Sym2.lift ⟨fun a b i => (if a = v ∧ p b = i then 1 else 0) +
      (if b = v ∧ p a = i then 1 else 0), by
    intro a b; funext i; exact add_comm _ _⟩ e

/-- The (ordered) edge-count vector of an edge set. -/
def edgeVec (p : V → Fin t) (E : Finset (Sym2 V)) : Fin t → Fin t → ℤ :=
  ∑ e ∈ E, pairVec p e

/-- The degree vector `d_E(v) = (|N_E(v) ∩ V_i| : i ∈ [t])`. -/
def degVec (p : V → Fin t) (E : Finset (Sym2 V)) (v : V) : Fin t → ℤ :=
  ∑ e ∈ E, degContrib p v e

/-- The (ordered) edge-count vector of the partitioned triangle `τ = T_{ijk}`. -/
def typeEdgeVec (τ : Multiset (Fin t)) : Fin t → Fin t → ℤ :=
  fun i j => (τ.count i : ℤ) * τ.count j - if i = j then (τ.count i : ℤ) else 0

/-- The degree vector of a vertex of part `a` inside the partitioned triangle `τ`. -/
def typeDegVec (τ : Multiset (Fin t)) (a : Fin t) : Fin t → ℤ :=
  fun i => (τ.count i : ℤ) - if i = a then 1 else 0

/-! ### Divisibility (Definition 13.5) -/

/-- **Integral `F`-divisibility** (Definition 13.5): the edge vector lies in the lattice
generated by the edge vectors of the types in `F`, and for every vertex `v` the degree vector
`d(v)` lies in the lattice generated by the degree vectors of the vertices of part `p v`
in the types of `F`. -/
def IsIntDiv (p : V → Fin t) (F : Finset (Multiset (Fin t))) (E : Finset (Sym2 V)) : Prop :=
  (∃ c : Multiset (Fin t) → ℤ, edgeVec p E = ∑ τ ∈ F, c τ • typeEdgeVec τ) ∧
    ∀ v : V, ∃ c : Multiset (Fin t) → ℤ,
      degVec p E v = ∑ τ ∈ F with p v ∈ τ, c τ • typeDegVec τ (p v)

/-- **Fractional `F`-divisibility** (Definition 13.5): as `IsIntDiv`, with the lattices
replaced by the cones (non-negative real combinations). -/
def IsFracDiv (p : V → Fin t) (F : Finset (Multiset (Fin t))) (E : Finset (Sym2 V)) : Prop :=
  (∃ c : Multiset (Fin t) → ℝ, (∀ τ, 0 ≤ c τ) ∧
      (fun i j => (edgeVec p E i j : ℝ)) = ∑ τ ∈ F, c τ • fun i j => (typeEdgeVec τ i j : ℝ)) ∧
    ∀ v : V, ∃ c : Multiset (Fin t) → ℝ, (∀ τ, 0 ≤ c τ) ∧
      (fun i => (degVec p E v i : ℝ)) =
        ∑ τ ∈ F with p v ∈ τ, c τ • fun i => (typeDegVec τ (p v) i : ℝ)

/-! ### Copies and decompositions (Definition 13.2) -/

/-- The edge set of the triangle with vertex set `s`. -/
def triEdges (s : Finset V) : Finset (Sym2 V) := s.sym2.filter (fun e => ¬ e.IsDiag)

/-- `s` is a triangle (3-vertex set) whose multiset of parts is a type of `F`. -/
def IsTypedTri (p : V → Fin t) (F : Finset (Multiset (Fin t))) (s : Finset V) : Prop :=
  s.card = 3 ∧ s.val.map p ∈ F

/-- `D` is an `F`-decomposition of the edge set `E`: a family of typed triangles whose edge
sets are pairwise disjoint and whose union is exactly `E`. -/
def IsDecomp (p : V → Fin t) (F : Finset (Multiset (Fin t))) (E : Finset (Sym2 V))
    (D : Finset (Finset V)) : Prop :=
  (∀ s ∈ D, IsTypedTri p F s) ∧ (D : Set (Finset V)).PairwiseDisjoint triEdges ∧
    D.biUnion triEdges = E

/-- The edge set `E` admits an `F`-decomposition. -/
def HasDecomp (p : V → Fin t) (F : Finset (Multiset (Fin t))) (E : Finset (Sym2 V)) : Prop :=
  ∃ D, IsDecomp p F E D

/-- An `F`-copy in the graph `G`: a triangle of `G` whose type belongs to `F`. -/
def IsCopy (p : V → Fin t) (F : Finset (Multiset (Fin t))) (G : SimpleGraph V)
    (s : Finset V) : Prop :=
  G.IsNClique 3 s ∧ s.val.map p ∈ F

/-- The finite set of `F`-copies of `G`. -/
noncomputable def copies (p : V → Fin t) (F : Finset (Multiset (Fin t))) (G : SimpleGraph V) :
    Finset (Finset V) := by
  classical exact (Finset.univ.powersetCard 3).filter (fun s => IsCopy p F G s)

/-! ### Fractional packings (Definitions 13.9, 13.10) -/

/-- `φ` is a **`C`-regular, `ε`-almost fractional `F`-packing** of `G` (`n = |V|`):
every `F`-copy has weight in `[1/(C n), C/n]` (`v(T) - 2 = 1` for triangles), and for every
edge `e` of `G` the total weight of the copies containing `e` lies in `[1 - ε, 1]`. -/
def IsRegularAlmostPacking (p : V → Fin t) (F : Finset (Multiset (Fin t))) (G : SimpleGraph V)
    [DecidableRel G.Adj] (C ε : ℝ) (φ : Finset V → ℝ) : Prop :=
  (∀ s, IsCopy p F G s →
      1 / (C * Fintype.card V) ≤ φ s ∧ φ s ≤ C / Fintype.card V) ∧
    ∀ e ∈ G.edgeFinset,
      1 - ε ≤ ∑ s ∈ copies p F G with e ∈ triEdges s, φ s ∧
        ∑ s ∈ copies p F G with e ∈ triEdges s, φ s ≤ 1

/-! ### Anti-edges and hinges (Definitions 13.11–13.15) -/

/-- **`α`-`F`-anti-edgeful** (Definition 13.13): for every type `T_{ijk} ∈ F` (with any choice of
the ordering `i, j, k` of its parts) and all distinct `u ∈ V_i`, `v ∈ V_j` (adjacent or not),
there are at least `α n` anti-edges `u w v` with `w ∈ V_k`. -/
def AntiEdgeful (p : V → Fin t) (F : Finset (Multiset (Fin t))) (G : SimpleGraph V)
    [DecidableRel G.Adj] (α : ℝ) : Prop :=
  ∀ τ ∈ F, ∀ i j k : Fin t, τ = {i, j, k} → ∀ u v : V, u ≠ v → p u = i → p v = j →
    α * Fintype.card V ≤ (univ.filter (fun w => G.Adj u w ∧ G.Adj w v ∧ p w = k)).card

/-- The set of vertices covered by an edge set. -/
def vertSet (H : Finset (Sym2 V)) : Finset V := univ.filter (fun v => ∃ e ∈ H, v ∈ e)

/-- `H` is an **`F`-hinge** for the copies `S, S'` (sharing exactly one edge `e`)
(Definition 13.14): `H` is edge-disjoint from `S ∪ S'` and both `H ∪ (S - e)` and
`H ∪ (S' - e)` admit `F`-decompositions. -/
def IsHinge (p : V → Fin t) (F : Finset (Multiset (Fin t))) (S S' : Finset V)
    (H : Finset (Sym2 V)) : Prop :=
  Disjoint H (triEdges S ∪ triEdges S') ∧
    HasDecomp p F (H ∪ (triEdges S \ triEdges S')) ∧
    HasDecomp p F (H ∪ (triEdges S' \ triEdges S))

/-- **`(α, C)`-`F`-hingeful** (Definition 13.15): for every two `F`-copies `S, S'` of `G` sharing
exactly one edge, there is `i ∈ [C]` such that `G` contains at least `α n^{i-2}` `F`-hinges for
`S, S'` with exactly `i` vertices. -/
noncomputable def Hingeful (p : V → Fin t) (F : Finset (Multiset (Fin t))) (G : SimpleGraph V)
    [DecidableRel G.Adj] (α : ℝ) (C : ℕ) : Prop :=
  open Classical in
  ∀ S S', IsCopy p F G S → IsCopy p F G S' → (triEdges S ∩ triEdges S').card = 1 →
    ∃ i ∈ Icc 1 C, α * (Fintype.card V : ℝ) ^ ((i : ℤ) - 2) ≤
      ((G.edgeFinset.powerset.filter
        (fun H => IsHinge p F S S' H ∧ (vertSet H).card = i)).card : ℝ)

/-- Maximum degree of an edge set is at most `d`. -/
def DegBounded (E : Finset (Sym2 V)) (d : ℝ) : Prop :=
  ∀ v : V, ((E.filter (fun e => v ∈ e)).card : ℝ) ≤ d

end PartitionedTriangleAbsorption
