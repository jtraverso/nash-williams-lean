module

public import PartitionedTriangleAbsorption.BlowupB.ZeroDeg

/-! # BlowupB.Uniform — aggregate = physical on complete blowups, for every family

**Theorem** (`physDiv_of_isIntDiv_uniform`). Let `F` be any family of partitioned triangle types
(multisets of size `3`), and `G` the complete `F`-blowup of a partition `p` with at least `5`
vertices in every class. Then every integrally `F`-divisible edge set of `G` (Definition 13.5)
lies in the physical lattice generated by the `F`-copies of `G`.

No finite per-family hypothesis is needed (compare `RepComplete` in `RepHost`). The threshold
`5` matches the computational gate: with `≤ 4` vertices per class the statement fails for
families containing monochromatic types.

Proof:
1. subtract `∑ τ c τ · (fixed copy of type τ)` to kill the edge-count vector;
2. at every non-base vertex `v`, subtract the difference gadgets
   `T(v,x,y) - T(o,x,y)` (`exists_deg_gadget`), which move the degree vector of `v` to the base
   vertex `o` of its class; the base vertex ends with the class sum, which is the (zero)
   edge-count vector;
3. the residual is balanced, hence physical (`physDivZ_of_zeroDeg`).
-/

@[expose] public section

namespace PartitionedTriangleAbsorption.BlowupB

open Finset

variable {V : Type*} [Fintype V] [DecidableEq V] {t : ℕ}

theorem degVecZ_sum (p : V → Fin t) {ι : Type*} (s : Finset ι) (f : ι → Sym2 V → ℤ) (v : V) :
    degVecZ p (∑ i ∈ s, f i) v = ∑ i ∈ s, degVecZ p (f i) v := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [degVecZ_zero]
  | insert a s ha ih => rw [sum_insert ha, sum_insert ha, degVecZ_add, ih]

omit [Fintype V] in
theorem sum_degContrib_class [Fintype V] (p : V → Fin t) (i j : Fin t) (e : Sym2 V) :
    ∑ v ∈ univ.filter (fun v => p v = i), degContrib p v e j = pairVec p e i j := by
  induction e using Sym2.ind with
  | _ a b =>
    simp only [degContrib, pairVec, Sym2.lift_mk, sum_add_distrib, ite_and]
    rw [Finset.sum_ite_eq, Finset.sum_ite_eq]
    simp [mem_filter]

/-- The degree vectors of a class add up to the corresponding row of the edge-count vector. -/
theorem sum_degVecZ_class (p : V → Fin t) (u : Sym2 V → ℤ) (i j : Fin t) :
    ∑ v ∈ univ.filter (fun v => p v = i), degVecZ p u v j = edgeVecZ p u i j := by
  simp only [degVecZ_apply, edgeVecZ_apply]
  rw [sum_comm]
  refine sum_congr rfl fun e _ => ?_
  rw [← mul_sum, sum_degContrib_class]

variable {p : V → Fin t} {F : Finset (Multiset (Fin t))} {G : SimpleGraph V}

omit [Fintype V] in
/-- A copy of every type, on the representatives. -/
theorem exists_copy_of_type (hG : IsCompleteBlowup p F G) (R : Reps p 5)
    {τ : Multiset (Fin t)} (hτ : τ ∈ F) (hc : Multiset.card τ = 3) :
    ∃ T : Finset V, IsCopy p F G T ∧ triType p T = τ := by
  obtain ⟨a, b, c, rfl⟩ := Multiset.card_eq_three.mp hc
  have h01 : R.rep a 0 ≠ R.rep b 1 := fun h => absurd (R.inj _ _ _ _ h).2 (by decide)
  have h02 : R.rep a 0 ≠ R.rep c 2 := fun h => absurd (R.inj _ _ _ _ h).2 (by decide)
  have h12 : R.rep b 1 ≠ R.rep c 2 := fun h => absurd (R.inj _ _ _ _ h).2 (by decide)
  refine ⟨{R.rep a 0, R.rep b 1, R.rep c 2}, isCopy_of_complete hG h01 h02 h12 ?_, ?_⟩
  · rw [R.cls, R.cls, R.cls]; exact hτ
  · rw [triType, map_three p h01 h02 h12, R.cls, R.cls, R.cls]

/-- **Difference gadget.** For a non-base vertex `v` and a type `τ ∋ p v`, a physical function
with zero edge-count vector whose degree vectors are `typeDegVec τ (p v)` at `v`, its negative
at the base vertex of the class of `v`, and `0` elsewhere. -/
theorem exists_deg_gadget (hG : IsCompleteBlowup p F G) (R : Reps p 5)
    (hF3 : ∀ τ ∈ F, Multiset.card τ = 3) {v : V} (hv : v ≠ R.rep (p v) 0)
    {τ : Multiset (Fin t)} (hτ : τ ∈ F) (hi : p v ∈ τ) :
    ∃ g : Sym2 V → ℤ, PhysDivZ p F G g ∧ edgeVecZ p g = 0 ∧ ∀ w, degVecZ p g w =
      (if w = v then typeDegVec τ (p v) else 0) -
        (if w = R.rep (p v) 0 then typeDegVec τ (p v) else 0) := by
  obtain ⟨τ', hτ'⟩ := Multiset.exists_cons_of_mem hi
  have hc' : Multiset.card τ' = 2 := by
    have := hF3 τ hτ
    rw [hτ', Multiset.card_cons] at this
    omega
  obtain ⟨a, b, rfl⟩ := Multiset.card_eq_two.mp hc'
  subst hτ'
  set v0 := R.rep (p v) 0 with hv0
  obtain ⟨ma, hma⟩ := R.exists_avoid a {v, v0} (lt_of_le_of_lt card_le_two (by norm_num))
  obtain ⟨mb, hmb⟩ := R.exists_avoid b {v, v0, R.rep a ma}
    (lt_of_le_of_lt card_le_three (by norm_num))
  simp only [mem_insert, mem_singleton, not_or] at hma hmb
  set x := R.rep a ma with hx
  set y := R.rep b mb with hy
  have hpx : p x = a := R.cls _ _
  have hpy : p y = b := R.cls _ _
  have hpv0 : p v0 = p v := R.cls _ _
  have hvx : v ≠ x := fun h => hma.1 h.symm
  have hvy : v ≠ y := fun h => hmb.1 h.symm
  have hxy : x ≠ y := fun h => hmb.2.2 h.symm
  have h0x : v0 ≠ x := fun h => hma.2 h.symm
  have h0y : v0 ≠ y := fun h => hmb.2.1 h.symm
  have hτ3 : ({p v, p x, p y} : Multiset (Fin t)) ∈ F := by rw [hpx, hpy]; exact hτ
  have hT1 := isCopy_of_complete hG hvx hvy hxy hτ3
  have hT2 := isCopy_of_complete hG h0x h0y hxy (by rw [hpv0]; exact hτ3)
  have htt1 : triType p {v, x, y} = p v ::ₘ {a, b} := by
    rw [triType, map_three p hvx hvy hxy, hpx, hpy]; rfl
  have htt2 : triType p {v0, x, y} = p v ::ₘ {a, b} := by
    rw [triType, map_three p h0x h0y hxy, hpv0, hpx, hpy]; rfl
  refine ⟨indZ (triEdges {v, x, y}) - indZ (triEdges {v0, x, y}),
    (physDivZ_of_isCopy hT1).sub (physDivZ_of_isCopy hT2), ?_, fun w => ?_⟩
  · rw [edgeVecZ_sub, edgeVecZ_indZ, edgeVecZ_indZ, edgeVec_triEdges p hT1.1.card_eq,
      edgeVec_triEdges p hT2.1.card_eq, htt1, htt2, sub_self]
  · rw [degVecZ_sub, degVecZ_indZ, degVecZ_indZ, degVec_triEdges p hT1.1.card_eq,
      degVec_triEdges p hT2.1.card_eq, htt1, htt2]
    by_cases hwv : w = v
    · rw [hwv]
      simp [hvx, hvy, hv]
    · by_cases hw0 : w = v0
      · rw [hw0]
        have h0v : v0 ≠ v := fun h => hv h.symm
        simp [h0x, h0y, h0v, hpv0]
      · by_cases hwx : w = x
        · rw [hwx]
          simp [Ne.symm hvx, Ne.symm h0x]
        · by_cases hwy : w = y
          · rw [hwy]
            simp [Ne.symm hvy, Ne.symm h0y]
          · simp [hwv, hw0, hwx, hwy]

/-- **Uniform reduction theorem.** In a complete `F`-blowup with at least `5` vertices in every
class, every integrally `F`-divisible edge set lies in the physical lattice of the `F`-copies. -/
theorem physDiv_of_isIntDiv_uniform [DecidableRel G.Adj] (hG : IsCompleteBlowup p F G)
    (hF3 : ∀ τ ∈ F, Multiset.card τ = 3) (R : Reps p 5) {E : Finset (Sym2 V)}
    (hE : E ⊆ G.edgeFinset) (hdiv : IsIntDiv p F E) : PhysDiv p F G E := by
  -- (a) kill the edge-count vector
  obtain ⟨c, hc⟩ := hdiv.1
  have hT : ∀ τ : Multiset (Fin t), ∃ T : Finset V,
      τ ∈ F → IsCopy p F G T ∧ triType p T = τ := by
    intro τ
    by_cases hτ : τ ∈ F
    · obtain ⟨T, h1, h2⟩ := exists_copy_of_type hG R hτ (hF3 τ hτ)
      exact ⟨T, fun _ => ⟨h1, h2⟩⟩
    · exact ⟨∅, fun h => absurd h hτ⟩
  choose T hT using hT
  have hzP : PhysDivZ p F G (∑ τ ∈ F, c τ • indZ (triEdges (T τ))) :=
    PhysDivZ.sum _ _ fun τ hτ => (physDivZ_of_isCopy (hT τ hτ).1).smul _
  have hzE : edgeVecZ p (∑ τ ∈ F, c τ • indZ (triEdges (T τ))) = edgeVec p E := by
    rw [edgeVecZ_sum, hc]
    refine sum_congr rfl fun τ hτ => ?_
    rw [edgeVecZ_smul, edgeVecZ_indZ, edgeVec_triEdges p (hT τ hτ).1.1.card_eq, (hT τ hτ).2]
  set z := ∑ τ ∈ F, c τ • indZ (triEdges (T τ)) with hz
  set u := indZ E - z with hu
  have huE : edgeVecZ p u = 0 := by rw [hu, edgeVecZ_sub, edgeVecZ_indZ, hzE, sub_self]
  have huA : AggDivZ p F u :=
    ((aggDivZ_indZ_iff p F E).mpr hdiv).sub (aggDivZ_of_physDivZ hzP)
  -- (b) move every degree vector to the base vertex of its class
  choose d hd using huA.2
  have hΓ : ∀ v : V, ∃ Γ : Sym2 V → ℤ, PhysDivZ p F G Γ ∧ edgeVecZ p Γ = 0 ∧ ∀ w,
      degVecZ p Γ w = (if w = v then degVecZ p u v else 0) -
        (if w = R.rep (p v) 0 then degVecZ p u v else 0) := by
    intro v
    by_cases hv : v = R.rep (p v) 0
    · refine ⟨0, PhysDivZ.zero, edgeVecZ_zero p, fun w => ?_⟩
      rw [degVecZ_zero, ← hv, sub_self]
    · have hg : ∀ τ : Multiset (Fin t), ∃ g : Sym2 V → ℤ, τ ∈ F.filter (p v ∈ ·) →
          PhysDivZ p F G g ∧ edgeVecZ p g = 0 ∧ ∀ w, degVecZ p g w =
            (if w = v then typeDegVec τ (p v) else 0) -
              (if w = R.rep (p v) 0 then typeDegVec τ (p v) else 0) := by
        intro τ
        by_cases hτ : τ ∈ F.filter (p v ∈ ·)
        · obtain ⟨hτF, hτv⟩ := mem_filter.mp hτ
          obtain ⟨g, h1, h2, h3⟩ := exists_deg_gadget hG R hF3 hv hτF hτv
          exact ⟨g, fun _ => ⟨h1, h2, h3⟩⟩
        · exact ⟨0, fun h => absurd h hτ⟩
      choose g hg using hg
      refine ⟨∑ τ ∈ F with p v ∈ τ, d v τ • g τ,
        PhysDivZ.sum _ _ fun τ hτ => ((hg τ hτ).1).smul _, ?_, fun w => ?_⟩
      · rw [edgeVecZ_sum]
        exact sum_eq_zero fun τ hτ => by rw [edgeVecZ_smul, (hg τ hτ).2.1, smul_zero]
      · have hL : degVecZ p (∑ τ ∈ F with p v ∈ τ, d v τ • g τ) w =
            ∑ τ ∈ F with p v ∈ τ, d v τ • ((if w = v then typeDegVec τ (p v) else 0) -
              (if w = R.rep (p v) 0 then typeDegVec τ (p v) else 0)) := by
          rw [degVecZ_sum]
          exact sum_congr rfl fun τ hτ => by rw [degVecZ_smul, (hg τ hτ).2.2 w]
        rw [hL, hd v]
        by_cases h1 : w = v
        · rw [h1]
          simp [hv]
        · by_cases h2 : w = R.rep (p v) 0
          · have h1' : R.rep (p v) 0 ≠ v := fun h => h1 (h2.trans h)
            rw [h2]
            simp [h1']
          · simp [h1, h2]
  choose Γ hΓ using hΓ
  set u' := u - ∑ v, Γ v with hu'
  have hu'E : edgeVecZ p u' = 0 := by
    rw [hu', edgeVecZ_sub, edgeVecZ_sum, huE, sum_eq_zero fun v _ => (hΓ v).2.1, sub_zero]
  have hu'D : ∀ w, degVecZ p u' w = 0 := by
    intro w
    have hS : ∑ v, degVecZ p (Γ v) w = degVecZ p u w -
        ∑ v ∈ univ.filter (fun v => w = R.rep (p v) 0), degVecZ p u v := by
      rw [sum_congr rfl fun v _ => (hΓ v).2.2 w, sum_sub_distrib, Finset.sum_ite_eq,
        if_pos (mem_univ _), sum_filter]
    have hF : ∑ v ∈ univ.filter (fun v => w = R.rep (p v) 0), degVecZ p u v = 0 := by
      by_cases hw : w = R.rep (p w) 0
      · have hfil : univ.filter (fun v => w = R.rep (p v) 0) =
            univ.filter (fun v => p v = p w) := by
          ext v
          simp only [mem_filter, mem_univ, true_and]
          constructor
          · intro h; rw [h, R.cls]
          · intro h; rw [h]; exact hw
        rw [hfil]
        funext j
        rw [Finset.sum_apply, sum_degVecZ_class, huE]
        rfl
      · refine sum_eq_zero fun v hv' => absurd ?_ hw
        have h := (mem_filter.mp hv').2
        have hpw : p w = p v := by rw [h, R.cls]
        rw [hpw]; exact h
    rw [hu', degVecZ_sub, degVecZ_sum, hS, hF, sub_zero, sub_self]
  -- (c) the balanced residual is physical
  have hΓP : PhysDivZ p F G (∑ v, Γ v) := PhysDivZ.sum _ _ fun v _ => (hΓ v).1
  have hOnG : OnG G u' := by
    rw [hu', hu]
    exact ((onG_indZ hE).sub (onG_of_physDivZ hzP)).sub (onG_of_physDivZ hΓP)
  have hu'P : PhysDivZ p F G u' := physDivZ_of_zeroDeg hG R hOnG hu'E hu'D
  rw [physDiv_iff_physDivZ]
  have hsplit : indZ E = u' + z + ∑ v, Γ v := by rw [hu', hu]; abel
  rw [hsplit]
  exact (hu'P.add hzP).add hΓP

/-- **Corollary.** In a complete `F`-blowup with at least `5` vertices per class, integral
divisibility (Definition 13.5) and physical divisibility coincide. -/
theorem isIntDiv_iff_physDiv_uniform [DecidableRel G.Adj] (hG : IsCompleteBlowup p F G)
    (hF3 : ∀ τ ∈ F, Multiset.card τ = 3) (R : Reps p 5) {E : Finset (Sym2 V)}
    (hE : E ⊆ G.edgeFinset) : IsIntDiv p F E ↔ PhysDiv p F G E :=
  ⟨physDiv_of_isIntDiv_uniform hG hF3 R hE, isIntDiv_of_physDiv⟩

end PartitionedTriangleAbsorption.BlowupB
