module

public import PartitionedTriangleAbsorption.BlowupB.Rectangle

/-! # BlowupB.Star — step 2 of the reduction: canonical spokes ↦ representative edges

At a vertex `x` of class `i`, the canonical spokes `∑ k, d k • cs x k` whose coefficient vector
`d` lies in the lattice generated by the type degree vectors `typeDegVec τ i` (`τ ∈ F`, `i ∈ τ`)
are rewritten, modulo copies, as edges among representatives:

* `star_type`: for one type `τ = {i, k, k'}`, `cs x k + cs x k' ≡ -(canon k x, canon k' x)`
  (cost `1`), and for `τ = {i, k, k}`, `2 • cs x k ≡ (rep–rep edges)` (cost `3`);
* `star_vertex`: linear combination over `τ`;
* `step2`: all vertices at once, from integral divisibility.
-/

@[expose] public section

namespace PartitionedTriangleAbsorption.BlowupB

open Finset

variable {V : Type*} [Fintype V] [DecidableEq V] {t : ℕ}

/-! ### Identities -/

omit [Fintype V] in
theorem star_identity_ne {x ρ ρ' : V} (hxρ : x ≠ ρ) (hxρ' : x ≠ ρ') (hρρ' : ρ ≠ ρ') :
    ind1 s(x, ρ) + ind1 s(x, ρ') - (-(ind1 s(ρ, ρ'))) = indZ (triEdges {x, ρ, ρ'}) := by
  rw [indZ_triEdges_three hxρ hxρ' hρρ']
  abel

omit [Fintype V] in
theorem star_identity_eq {x ρ r s : V} (hxρ : x ≠ ρ) (hxr : x ≠ r) (hxs : x ≠ s)
    (hρr : ρ ≠ r) (hρs : ρ ≠ s) (hrs : r ≠ s) :
    ind1 s(x, ρ) + ind1 s(x, ρ) - (-(ind1 s(ρ, r) + ind1 s(ρ, s) - ind1 s(r, s))) =
      indZ (triEdges {x, ρ, r}) + indZ (triEdges {x, ρ, s}) - indZ (triEdges {x, r, s}) := by
  rw [indZ_triEdges_three hxρ hxr hρr, indZ_triEdges_three hxρ hxs hρs,
    indZ_triEdges_three hxr hxs hrs]
  abel

variable {p : V → Fin t} {q : ℕ}

/-- The canonical spokes weighted by a type degree vector are the two spokes of the type. -/
theorem sum_typeDegVec_cs (R : Reps p q) (hq : 5 ≤ q) (x : V) (k k' : Fin t) :
    ∑ l, typeDegVec {p x, k, k'} (p x) l • cs R hq x l = cs R hq x k + cs R hq x k' := by
  simp only [typeDegVec_three, add_smul, sum_add_distrib, ite_smul, one_smul, zero_smul,
    sum_ite_eq, mem_univ, if_true]

/-! ### Step 2 for one type -/

/-- **Step 2 for one type.** The spokes of `x` weighted by `typeDegVec τ (p x)` are, modulo
copies, supported on representative edges; cost at most `3`. -/
theorem star_type {F : Finset (Multiset (Fin t))} {G : SimpleGraph V}
    (hG : IsCompleteBlowup p F G) (R : Reps p q) (hq : 5 ≤ q) (x : V)
    {τ : Multiset (Fin t)} (hτ : τ ∈ F) (hc : Multiset.card τ = 3) (hi : p x ∈ τ) :
    ∃ wRR : Sym2 V → ℤ, OnReps R wRR ∧
      PhysCostZ p F G (∑ l, typeDegVec τ (p x) l • cs R hq x l - wRR) 3 := by
  have hq2 : 2 ≤ q := by omega
  obtain ⟨τ', rfl⟩ := Multiset.exists_cons_of_mem hi
  have hc' : Multiset.card τ' = 2 := by rw [Multiset.card_cons] at hc; omega
  obtain ⟨k, k', rfl⟩ := Multiset.card_eq_two.mp hc'
  have hτ3 : ({p x, k, k'} : Multiset (Fin t)) ∈ F := hτ
  rw [show (p x ::ₘ {k, k'} : Multiset (Fin t)) = {p x, k, k'} from rfl, sum_typeDegVec_cs]
  have hxρ : x ≠ R.canon hq2 k x := (R.canon_ne hq2 k x).symm
  have hxρ' : x ≠ R.canon hq2 k' x := (R.canon_ne hq2 k' x).symm
  have hpρ : p (R.canon hq2 k x) = k := R.canon_cls hq2 k x
  have hpρ' : p (R.canon hq2 k' x) = k' := R.canon_cls hq2 k' x
  have hρR : R.canon hq2 k x ∈ R.set := R.canon_mem hq2 k x
  have hρ'R : R.canon hq2 k' x ∈ R.set := R.canon_mem hq2 k' x
  by_cases hkk : k = k'
  · subst hkk
    obtain ⟨ir, hir⟩ := R.exists_avoid k {x, R.canon hq2 k x}
      (lt_of_le_of_lt card_le_two (by omega))
    obtain ⟨is, his⟩ := R.exists_avoid k {x, R.canon hq2 k x, R.rep k ir}
      (lt_of_le_of_lt card_le_three (by omega))
    simp only [mem_insert, mem_singleton, not_or] at hir his
    have hpr : p (R.rep k ir) = k := R.cls _ _
    have hps : p (R.rep k is) = k := R.cls _ _
    have hxr : x ≠ R.rep k ir := fun h => hir.1 h.symm
    have hρr : R.canon hq2 k x ≠ R.rep k ir := fun h => hir.2 h.symm
    have hxs : x ≠ R.rep k is := fun h => his.1 h.symm
    have hρs : R.canon hq2 k x ≠ R.rep k is := fun h => his.2.1 h.symm
    have hrs : R.rep k ir ≠ R.rep k is := fun h => his.2.2 h.symm
    have hT1 := physCostZ_of_isCopy (isCopy_of_complete hG hxρ hxr hρr
      (by rw [hpρ, hpr]; exact hτ3))
    have hT3 := physCostZ_of_isCopy (isCopy_of_complete hG hxρ hxs hρs
      (by rw [hpρ, hps]; exact hτ3))
    have hT2 := physCostZ_of_isCopy (isCopy_of_complete hG hxr hxs hrs
      (by rw [hpr, hps]; exact hτ3))
    refine ⟨-(ind1 s(R.canon hq2 k x, R.rep k ir) + ind1 s(R.canon hq2 k x, R.rep k is) -
      ind1 s(R.rep k ir, R.rep k is)), ?_, ?_⟩
    · exact (((OnReps.ind1 hρR (R.rep_mem _ _)).add (OnReps.ind1 hρR (R.rep_mem _ _))).sub
        (OnReps.ind1 (R.rep_mem _ _) (R.rep_mem _ _))).neg
    · refine (((hT1.add hT3).sub hT2).congr ?_).mono (by norm_num)
      unfold cs
      exact (star_identity_eq hxρ hxr hxs hρr hρs hrs).symm
  · have hρρ' : R.canon hq2 k x ≠ R.canon hq2 k' x := by
      intro h; apply hkk; rw [← hpρ, ← hpρ', h]
    have hT := physCostZ_of_isCopy (isCopy_of_complete hG hxρ hxρ' hρρ'
      (by rw [hpρ, hpρ']; exact hτ3))
    refine ⟨-(ind1 s(R.canon hq2 k x, R.canon hq2 k' x)), (OnReps.ind1 hρR hρ'R).neg, ?_⟩
    refine (hT.congr ?_).mono (by norm_num)
    unfold cs
    exact (star_identity_ne hxρ hxρ' hρρ').symm

/-! ### Step 2 for one vertex and for all vertices -/

/-- **Step 2 for one vertex.** If the coefficient vector `d` of the canonical spokes of `x` lies
in the lattice of the type degree vectors at `p x`, the spokes are, modulo copies, supported on
representative edges, at cost `3 ∑ |c τ|`. -/
theorem star_vertex {F : Finset (Multiset (Fin t))} {G : SimpleGraph V}
    (hG : IsCompleteBlowup p F G) (hF3 : ∀ τ ∈ F, Multiset.card τ = 3) (R : Reps p q)
    (hq : 5 ≤ q) (x : V) {d : Fin t → ℤ} {c : Multiset (Fin t) → ℤ}
    (hd : d = ∑ τ ∈ F with p x ∈ τ, c τ • typeDegVec τ (p x)) :
    ∃ wRR : Sym2 V → ℤ, OnReps R wRR ∧
      PhysCostZ p F G (∑ l, d l • cs R hq x l - wRR) (3 * ∑ τ ∈ F with p x ∈ τ, |c τ|) := by
  have hexp : ∑ l, d l • cs R hq x l =
      ∑ τ ∈ F with p x ∈ τ, c τ • ∑ l, typeDegVec τ (p x) l • cs R hq x l := by
    subst hd
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, sum_smul, mul_smul, smul_sum]
    rw [sum_comm]
  have key : ∀ τ : Multiset (Fin t), ∃ w : Sym2 V → ℤ, τ ∈ F.filter (p x ∈ ·) →
      OnReps R w ∧ PhysCostZ p F G (∑ l, typeDegVec τ (p x) l • cs R hq x l - w) 3 := by
    intro τ
    by_cases hτ : τ ∈ F.filter (p x ∈ ·)
    · obtain ⟨hτF, hxτ⟩ := mem_filter.mp hτ
      obtain ⟨w, hw, hc⟩ := star_type hG R hq x hτF (hF3 τ hτF) hxτ
      exact ⟨w, fun _ => ⟨hw, hc⟩⟩
    · exact ⟨0, fun h => absurd h hτ⟩
  choose w hw using key
  refine ⟨∑ τ ∈ F with p x ∈ τ, c τ • w τ,
    OnReps.sum _ _ (fun τ hτ => ((hw τ hτ).1).smul _), ?_⟩
  rw [hexp, ← sum_sub_distrib]
  simp_rw [← smul_sub]
  refine (PhysCostZ.sum _ _ (fun τ => |c τ| * 3) (fun τ hτ => ((hw τ hτ).2).smul (c τ))).mono ?_
  rw [mul_sum]
  exact le_of_eq (sum_congr rfl fun τ _ => mul_comm _ _)

/-- **Step 2.** Under integral divisibility of `E`, the canonical spokes of all vertices are,
modulo copies, supported on representative edges. -/
theorem step2 {F : Finset (Multiset (Fin t))} {G : SimpleGraph V}
    (hG : IsCompleteBlowup p F G) (hF3 : ∀ τ ∈ F, Multiset.card τ = 3) (R : Reps p q)
    (hq : 5 ≤ q) {E : Finset (Sym2 V)} (hdiv : IsIntDiv p F E) :
    ∃ (wRR : Sym2 V → ℤ) (K : ℤ), OnReps R wRR ∧
      PhysCostZ p F G (∑ x, ∑ l, degVec p E x l • cs R hq x l - wRR) K := by
  choose c hc using hdiv.2
  have key : ∀ x : V, ∃ w : Sym2 V → ℤ, OnReps R w ∧
      PhysCostZ p F G (∑ l, degVec p E x l • cs R hq x l - w)
        (3 * ∑ τ ∈ F with p x ∈ τ, |c x τ|) :=
    fun x => star_vertex hG hF3 R hq x (hc x)
  choose w hw using key
  refine ⟨∑ x, w x, ∑ x, 3 * ∑ τ ∈ F with p x ∈ τ, |c x τ|,
    OnReps.sum _ _ (fun x _ => (hw x).1), ?_⟩
  rw [← sum_sub_distrib]
  exact PhysCostZ.sum _ _ _ (fun x _ => (hw x).2)

end PartitionedTriangleAbsorption.BlowupB
