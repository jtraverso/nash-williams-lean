module

public import PartitionedTriangleAbsorption.BlowupB.Star

/-! # BlowupB.RepHost — step 3 and the reduction theorem

After steps 1 and 2 the residual integer edge function is supported on edges among the
representatives and is still aggregate divisible. We transport it to the **representative host**
`Fin t × Fin q` (the complete `F`-blowup with `q` vertices per class, partition `Prod.fst`),
where the finite hypothesis `RepComplete F q` ("aggregate ⇒ physical on the host") provides a
certificate, and transport the certificate back.

Main result: `physDiv_of_isIntDiv` — in a complete `F`-blowup with at least `5` representatives
per class, under `RepComplete F q`, every integrally `F`-divisible edge set lies in the physical
lattice generated by the `F`-copies.
-/

@[expose] public section

namespace PartitionedTriangleAbsorption.BlowupB

open Finset

variable {V : Type*} [Fintype V] [DecidableEq V] {t : ℕ}

/-! ### Physical divisibility of integer edge functions -/

/-- `w` has a physical certificate. -/
def PhysDivZ (p : V → Fin t) (F : Finset (Multiset (Fin t))) (G : SimpleGraph V)
    (w : Sym2 V → ℤ) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι) (T : ι → Finset V) (c : ι → ℤ), PhysCertZ p F G w T c

omit [Fintype V] in
theorem physDiv_iff_physDivZ {p : V → Fin t} {F : Finset (Multiset (Fin t))} {G : SimpleGraph V}
    {E : Finset (Sym2 V)} : PhysDiv p F G E ↔ PhysDivZ p F G (indZ E) := Iff.rfl

omit [Fintype V] in
theorem physDivZ_of_physCostZ {p : V → Fin t} {F : Finset (Multiset (Fin t))} {G : SimpleGraph V}
    {w : Sym2 V → ℤ} {K : ℤ} (h : PhysCostZ p F G w K) : PhysDivZ p F G w := by
  obtain ⟨ι, hι, T, c, hc, _⟩ := h
  exact ⟨ι, hι, T, c, hc⟩

omit [Fintype V] in
theorem PhysDivZ.congr {p : V → Fin t} {F : Finset (Multiset (Fin t))} {G : SimpleGraph V}
    {w w' : Sym2 V → ℤ} (h : PhysDivZ p F G w) (hw : w = w') : PhysDivZ p F G w' := hw ▸ h

omit [Fintype V] in
theorem PhysDivZ.add {p : V → Fin t} {F : Finset (Multiset (Fin t))} {G : SimpleGraph V}
    {w₁ w₂ : Sym2 V → ℤ} (h₁ : PhysDivZ p F G w₁) (h₂ : PhysDivZ p F G w₂) :
    PhysDivZ p F G (w₁ + w₂) := by
  obtain ⟨ι₁, hι₁, T₁, c₁, hT₁, hw₁⟩ := h₁
  obtain ⟨ι₂, hι₂, T₂, c₂, hT₂, hw₂⟩ := h₂
  refine ⟨ι₁ ⊕ ι₂, inferInstance, Sum.elim T₁ T₂, Sum.elim c₁ c₂, ?_, fun e => ?_⟩
  · rintro (j | j)
    · exact hT₁ j
    · exact hT₂ j
  · rw [Pi.add_apply, hw₁ e, hw₂ e, Fintype.sum_sum_type]
    simp only [Sum.elim_inl, Sum.elim_inr]

/-! ### Complete blowup graphs and the representative host -/

/-- The complete `F`-blowup graph of a partition. -/
def blowupGraph (p : V → Fin t) (F : Finset (Multiset (Fin t))) : SimpleGraph V where
  Adj u v := u ≠ v ∧ AllowedPair F (p u) (p v)
  symm := ⟨fun _ _ h => ⟨h.1.symm, h.2.symm⟩⟩
  loopless := ⟨fun _ h => h.1 rfl⟩

omit [Fintype V] [DecidableEq V] in
theorem isCompleteBlowup_blowupGraph (p : V → Fin t) (F : Finset (Multiset (Fin t))) :
    IsCompleteBlowup p F (blowupGraph p F) := fun _ _ => Iff.rfl

/-- **The finite hypothesis of a family.** On the representative host with `q` vertices per
class, every aggregate divisible integer edge function has a physical certificate. -/
def RepComplete (F : Finset (Multiset (Fin t))) (q : ℕ) : Prop :=
  ∀ w : Sym2 (Fin t × Fin q) → ℤ, AggDivZ Prod.fst F w →
    PhysDivZ Prod.fst F (blowupGraph Prod.fst F) w

/-! ### Transport along the representatives -/

namespace Reps

variable {p : V → Fin t} {q : ℕ} (R : Reps p q)

/-- The representatives as an embedding of the host. -/
def emb : Fin t × Fin q ↪ V :=
  ⟨fun x => R.rep x.1 x.2, fun x y h => by
    obtain ⟨h1, h2⟩ := R.inj _ _ _ _ h
    exact Prod.ext h1 h2⟩

omit [Fintype V] [DecidableEq V] in
theorem emb_apply (x : Fin t × Fin q) : R.emb x = R.rep x.1 x.2 := rfl

omit [Fintype V] [DecidableEq V] in
theorem cls_emb (x : Fin t × Fin q) : p (R.emb x) = x.1 := R.cls _ _

omit [Fintype V] in
theorem emb_mem (x : Fin t × Fin q) : R.emb x ∈ R.set := R.rep_mem _ _

omit [Fintype V] in
theorem mem_set_iff_emb {v : V} : v ∈ R.set ↔ ∃ x, R.emb x = v := by
  rw [mem_set_iff]
  constructor
  · rintro ⟨i, a, h⟩; exact ⟨(i, a), h⟩
  · rintro ⟨x, h⟩; exact ⟨x.1, x.2, h⟩

/-- Pull an integer edge function on `V` back to the host. -/
def pull (w : Sym2 V → ℤ) : Sym2 (Fin t × Fin q) → ℤ := fun e => w (Sym2.map R.emb e)

omit [Fintype V] [DecidableEq V] in
theorem pairVec_map (e : Sym2 (Fin t × Fin q)) :
    pairVec p (Sym2.map R.emb e) = pairVec Prod.fst e := by
  induction e using Sym2.ind with
  | _ a b =>
    funext i j
    simp [pairVec, R.cls_emb]

omit [Fintype V] in
theorem degContrib_map (x : Fin t × Fin q) (e : Sym2 (Fin t × Fin q)) :
    degContrib p (R.emb x) (Sym2.map R.emb e) = degContrib Prod.fst x e := by
  induction e using Sym2.ind with
  | _ a b =>
    funext i
    simp [degContrib, R.cls_emb, R.emb.injective.eq_iff]

/-- Sums over all edges of a function vanishing off the support of an `OnReps` function can be
taken over the host. -/
theorem sum_of_onReps {M : Type*} [AddCommMonoid M] {w : Sym2 V → ℤ} (hw : OnReps R w)
    (g : Sym2 V → M) (hg : ∀ e, w e = 0 → g e = 0) :
    ∑ e, g e = ∑ e' : Sym2 (Fin t × Fin q), g (Sym2.map R.emb e') := by
  have hmap : ∑ e' : Sym2 (Fin t × Fin q), g (Sym2.map R.emb e') =
      ∑ e ∈ univ.map R.emb.sym2Map, g e := by
    rw [Finset.sum_map]
    rfl
  rw [hmap]
  symm
  apply Finset.sum_subset (subset_univ _)
  intro e _ he
  apply hg
  by_contra hne
  apply he
  induction e using Sym2.ind with
  | _ x y =>
    obtain ⟨a, ha⟩ := R.mem_set_iff_emb.mp (hw _ hne x (Sym2.mem_mk_left x y))
    obtain ⟨b, hb⟩ := R.mem_set_iff_emb.mp (hw _ hne y (Sym2.mem_mk_right x y))
    exact mem_map.mpr ⟨s(a, b), mem_univ _, by
      simp only [Function.Embedding.sym2Map_apply, Sym2.map_mk, ha, hb]⟩

theorem edgeVecZ_pull {w : Sym2 V → ℤ} (hw : OnReps R w) :
    edgeVecZ Prod.fst (R.pull w) = edgeVecZ p w := by
  unfold edgeVecZ
  rw [R.sum_of_onReps hw (fun e => w e • pairVec p e) (fun e h => by simp [h])]
  exact sum_congr rfl fun e' _ => by rw [pull, R.pairVec_map]

theorem degVecZ_pull {w : Sym2 V → ℤ} (hw : OnReps R w) (x : Fin t × Fin q) :
    degVecZ Prod.fst (R.pull w) x = degVecZ p w (R.emb x) := by
  unfold degVecZ
  rw [R.sum_of_onReps hw (fun e => w e • degContrib p (R.emb x) e) (fun e h => by simp [h])]
  exact sum_congr rfl fun e' _ => by rw [pull, R.degContrib_map]

/-- Aggregate divisibility transports to the host. -/
theorem aggDivZ_pull {F : Finset (Multiset (Fin t))} {w : Sym2 V → ℤ} (hw : OnReps R w)
    (h : AggDivZ p F w) : AggDivZ Prod.fst F (R.pull w) := by
  obtain ⟨⟨c, hc⟩, hl⟩ := h
  refine ⟨⟨c, by rw [R.edgeVecZ_pull hw, hc]⟩, fun x => ?_⟩
  obtain ⟨d, hd⟩ := hl (R.emb x)
  refine ⟨d, ?_⟩
  rw [R.degVecZ_pull hw, hd, R.cls_emb]

omit [Fintype V] in
theorem mem_triEdges_mk {T : Finset V} {x y : V} :
    s(x, y) ∈ triEdges T ↔ x ∈ T ∧ y ∈ T ∧ x ≠ y := by
  simp only [triEdges, mem_filter, mk_mem_sym2_iff, Sym2.mk_isDiag_iff]
  tauto

omit [Fintype V] [DecidableEq V] in
/-- Copies on the host map to copies of any complete blowup. -/
theorem isCopy_map {F : Finset (Multiset (Fin t))} {G : SimpleGraph V}
    (hG : IsCompleteBlowup p F G) {T : Finset (Fin t × Fin q)}
    (hT : IsCopy Prod.fst F (blowupGraph Prod.fst F) T) : IsCopy p F G (T.map R.emb) := by
  obtain ⟨hclique, htype⟩ := hT
  rw [SimpleGraph.isNClique_iff] at hclique
  refine ⟨?_, ?_⟩
  · rw [SimpleGraph.isNClique_iff]
    refine ⟨?_, by rw [card_map]; exact hclique.2⟩
    intro x hx y hy hxy
    rw [coe_map] at hx hy
    obtain ⟨a, ha, rfl⟩ := hx
    obtain ⟨b, hb, rfl⟩ := hy
    have hab : a ≠ b := fun h => hxy (by rw [h])
    have hadj := hclique.1 ha hb hab
    rw [hG]
    exact ⟨hxy, by rw [R.cls_emb, R.cls_emb]; exact hadj.2⟩
  · rw [map_val, Multiset.map_map]
    convert htype using 2
    exact R.cls_emb _

/-- A certificate on the host for the pull-back is a certificate on `V`. -/
theorem physCertZ_push {F : Finset (Multiset (Fin t))} {G : SimpleGraph V}
    (hG : IsCompleteBlowup p F G) {w : Sym2 V → ℤ} (hw : OnReps R w) {ι : Type*} [Fintype ι]
    {T : ι → Finset (Fin t × Fin q)} {c : ι → ℤ}
    (h : PhysCertZ Prod.fst F (blowupGraph Prod.fst F) (R.pull w) T c) :
    PhysCertZ p F G w (fun j => (T j).map R.emb) c := by
  obtain ⟨hcopy, hid⟩ := h
  refine ⟨fun j => R.isCopy_map hG (hcopy j), fun e => ?_⟩
  by_cases he : ∃ e', Sym2.map R.emb e' = e
  · obtain ⟨e', rfl⟩ := he
    have := hid e'
    rw [pull] at this
    rw [this]
    refine sum_congr rfl fun j _ => ?_
    congr 1
    induction e' using Sym2.ind with
    | _ a b =>
      simp only [indZ, Sym2.map_mk, mem_triEdges_mk, mem_map' R.emb, R.emb.injective.ne_iff]
  · push_neg at he
    have hw0 : w e = 0 := by
      by_contra hne
      induction e using Sym2.ind with
      | _ x y =>
        obtain ⟨a, ha⟩ := R.mem_set_iff_emb.mp (hw _ hne x (Sym2.mem_mk_left x y))
        obtain ⟨b, hb⟩ := R.mem_set_iff_emb.mp (hw _ hne y (Sym2.mem_mk_right x y))
        exact he s(a, b) (by rw [Sym2.map_mk, ha, hb])
    rw [hw0]
    symm
    apply Finset.sum_eq_zero
    intro j _
    rw [mul_eq_zero]
    right
    apply indZ_not_mem
    intro hmem
    induction e using Sym2.ind with
    | _ x y =>
      obtain ⟨hx, hy, _⟩ := mem_triEdges_mk.mp hmem
      obtain ⟨a, _, ha⟩ := mem_map.mp hx
      obtain ⟨b, _, hb⟩ := mem_map.mp hy
      exact he s(a, b) (by rw [Sym2.map_mk, ha, hb])

end Reps

/-! ### The reduction theorem -/

/-- **Reduction theorem.** Let `G` be the complete `F`-blowup of `p` (all types of `F` of size
`3`), with at least `5` representatives per class, and assume the finite hypothesis
`RepComplete F q`. Then every integrally `F`-divisible edge set of `G` lies in the physical
lattice of the `F`-copies of `G`. -/
theorem physDiv_of_isIntDiv {p : V → Fin t} {q : ℕ} {F : Finset (Multiset (Fin t))}
    {G : SimpleGraph V} [DecidableRel G.Adj] (hG : IsCompleteBlowup p F G)
    (hF3 : ∀ τ ∈ F, Multiset.card τ = 3) (R : Reps p q) (hq : 5 ≤ q)
    (hRC : RepComplete F q) {E : Finset (Sym2 V)} (hE : E ⊆ G.edgeFinset)
    (hdiv : IsIntDiv p F E) : PhysDiv p F G E := by
  obtain ⟨w₁, hw₁, hc₁⟩ := step1 hG R hq hE
  obtain ⟨w₂, K₂, hw₂, hc₂⟩ := step2 hG hF3 R hq hdiv
  have hc := hc₁.add hc₂
  have heq : indZ E - (∑ x, ∑ k, degVec p E x k • cs R hq x k + w₁) +
      (∑ x, ∑ l, degVec p E x l • cs R hq x l - w₂) = indZ E - (w₁ + w₂) := by abel
  have hc' := hc.congr heq
  have hw₃ : OnReps R (w₁ + w₂) := hw₁.add hw₂
  have hagg : AggDivZ p F (w₁ + w₂) := by
    have h0 : AggDivZ p F (indZ E) := (aggDivZ_indZ_iff p F E).mpr hdiv
    have h1 : AggDivZ p F (indZ E - (w₁ + w₂)) := aggDivZ_of_physCostZ hc'
    have := h0.sub h1
    convert this using 1
    abel
  obtain ⟨ι, hι, T', c, hcert⟩ := hRC _ (R.aggDivZ_pull hw₃ hagg)
  have hpush : PhysDivZ p F G (w₁ + w₂) :=
    ⟨ι, hι, fun j => (T' j).map R.emb, c, R.physCertZ_push hG hw₃ hcert⟩
  rw [physDiv_iff_physDivZ]
  have := (physDivZ_of_physCostZ hc').add hpush
  exact this.congr (by abel)

end PartitionedTriangleAbsorption.BlowupB
