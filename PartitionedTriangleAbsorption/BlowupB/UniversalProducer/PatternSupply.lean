module

public import PartitionedTriangleAbsorption.BlowupB.UniversalProducer.Patterns

@[expose] public section

/-!
# Pattern charges of host pieces, and physical token supply for each pattern

* `charge_mem_closure_genList`: every loopless, even edge set of a host with at most `m0`
  edges, all active, has its integral type charge in the subgroup generated by the fixed
  generator list `genList F m0 N0` (`2 m0 ≤ N0`).
* `tokSupply_of_pattern`: with guarded supply of order `|TU N0|` at scale `a`, every pattern
  gives the physical token supply `TokSupply` for its charge: plus tokens are copies of the
  plus template, minus tokens copies of the minus template.
-/

namespace PartitionedTriangleAbsorption.BlowupB.UniversalProducer

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.AntiEdgeSelection
open PartitionedTriangleAbsorption.StructuralF3General PartitionedTriangleAbsorption.TypedTransformer
open PartitionedTriangleAbsorption.StructuralF3General.RefinerF0

variable {t : ℕ}

section PieceCharge

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- Every bounded active loopless even edge set has the charge of a pattern. -/
theorem exists_pattern_of_piece (F : Finset (Multiset (Fin t))) (p : V → Fin t)
    {m0 N0 : ℕ} (hN : 2 * m0 ≤ N0) (E : Finset (Sym2 V)) (hE : E.Nonempty)
    (hloop : ∀ e ∈ E, ¬ e.IsDiag) (heven : ∀ v, Even (incidentLoad E v))
    (hact : ∀ u v, s(u, v) ∈ E → ∃ c, Link F (p u) (p v) c) (hcard : E.card ≤ m0) :
    ∃ P ∈ patterns F m0 N0, patCharge F P = globalCharge F (edgeVec p E) := by
  classical
  set S := vertSet E with hS
  have hSc : Fintype.card S ≤ Fintype.card (Fin N0) := by
    rw [Fintype.card_coe, Fintype.card_fin]
    exact (SignedHinge.card_vertSet_le E).trans (by omega)
  obtain ⟨emb⟩ := Function.Embedding.nonempty_of_card_le hSc
  obtain ⟨e0, he0⟩ := hE
  obtain ⟨v0, hv0⟩ : ∃ v0, v0 ∈ e0 := ⟨ea e0, by
    have := Sym2.mem_mk_left (ea e0) (eb e0)
    rwa [mk_ea_eb] at this⟩
  have hv0S : v0 ∈ S := SignedHinge.mem_vertSet.mpr ⟨e0, he0, hv0⟩
  have hmemS : ∀ e ∈ E, ∀ u ∈ e, u ∈ S := fun e he u hu =>
    SignedHinge.mem_vertSet.mpr ⟨e, he, hu⟩
  let h : V → Fin N0 := fun v => if hv : v ∈ S then emb ⟨v, hv⟩ else emb ⟨v0, hv0S⟩
  have hinj : Set.InjOn h (S : Set V) := by
    intro u hu v hv huv
    simp only [h, dif_pos (show u ∈ S from hu), dif_pos (show v ∈ S from hv)] at huv
    exact congrArg Subtype.val (emb.injective huv)
  haveI : Nonempty V := ⟨v0⟩
  let inv : Fin N0 → V := Function.invFunOn h (S : Set V)
  have hinv : ∀ v ∈ S, inv (h v) = v := fun v hv => hinj.leftInvOn_invFunOn hv
  have hVI : VInjOn h E := fun e he e' he' u hu u' hu' huu =>
    hinj (hmemS e he u hu) (hmemS e' he' u' hu') huu
  let ℓ : Fin N0 → Fin t := fun x => p (inv x)
  have hℓ : ∀ e ∈ E, ∀ u ∈ e, ℓ (h u) = p u := fun e he u hu => by
    simp only [ℓ, hinv u (hmemS e he u hu)]
  let P : Pat t N0 := (ℓ, E.image (Sym2.map h))
  refine ⟨P, mem_patterns.mpr ⟨loopless_image hVI hloop, even_image hVI heven, ?_,
    card_image_le.trans hcard⟩, congrArg (globalCharge F) (edgeVec_image hVI hℓ)⟩
  intro a b hab
  obtain ⟨e, he, hee⟩ := mem_image.mp hab
  induction e using Sym2.ind with
  | _ u v =>
    rw [Sym2.map_mk] at hee
    have hu := hℓ _ he u (Sym2.mem_mk_left u v)
    have hv := hℓ _ he v (Sym2.mem_mk_right u v)
    rcases Sym2.eq_iff.mp hee with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · change ∃ c, Link F (ℓ (h u)) (ℓ (h v)) c
      rw [hu, hv]; exact hact u v he
    · change ∃ c, Link F (ℓ (h v)) (ℓ (h u)) c
      rw [hu, hv]; exact allowed_symm (hact u v he)

/-- Charges of bounded active loopless even edge sets lie in the closure of `genList`. -/
theorem charge_mem_closure_genList (F : Finset (Multiset (Fin t))) (p : V → Fin t)
    {m0 N0 : ℕ} (hN : 2 * m0 ≤ N0) (E : Finset (Sym2 V))
    (hloop : ∀ e ∈ E, ¬ e.IsDiag) (heven : ∀ v, Even (incidentLoad E v))
    (hact : ∀ u v, s(u, v) ∈ E → ∃ c, Link F (p u) (p v) c) (hcard : E.card ≤ m0) :
    edgeVal (chargeVal F p) E ∈ AddSubgroup.closure {x | x ∈ genList F m0 N0} := by
  classical
  rw [edgeVal_chargeVal]
  rcases E.eq_empty_or_nonempty with rfl | hE
  · simp [edgeVec, (AddSubgroup.closure _).zero_mem]
  obtain ⟨P, hP, hPc⟩ := exists_pattern_of_piece F p hN E hE hloop heven hact hcard
  apply AddSubgroup.subset_closure
  rw [← hPc]
  exact List.mem_map.mpr ⟨P, mem_toList.mpr hP, rfl⟩

end PieceCharge

section Supply

variable {V : Type} [Fintype V] [DecidableEq V]

/-- **Physical token supply of a pattern.** -/
theorem tokSupply_of_pattern [Nonempty V] (F : Finset (Multiset (Fin t))) (p : V → Fin t)
    (G : SimpleGraph V) [DecidableRel G.Adj] {m0 N0 : ℕ} {P : Pat t N0}
    (hP : PatOK F m0 P) (a : ℝ)
    (hs : GuardedSupply p G (fun i j => ∃ k, Link F i j k) (Fintype.card (TU N0)) a)
    (Ncap Δ : ℕ) (dB : ℝ) (hdB : 0 ≤ dB) (hΔ : 2 * m0 < Δ)
    (hbudget : (Fintype.card (TU N0) : ℝ) + Fintype.card (TU N0) * (dB + Δ) < a / 2)
    (hcount : 4 * ((2 * m0 : ℕ) : ℝ) * (Ncap : ℝ) ≤ ((Δ : ℝ) - (2 * m0 : ℕ)) * a) :
    TokSupply (chargeVal F p) (patCharge F P) (2 * m0) G.edgeFinset Ncap dB Δ := by
  classical
  intro κ _ S B hS hB
  have hT : (0 : ℝ) < (Δ : ℝ) - (2 * m0 : ℕ) := by
    have : ((2 * m0 : ℕ) : ℝ) < Δ := by exact_mod_cast hΔ
    linarith
  have ha : 0 ≤ a := by
    have : (0 : ℝ) ≤ Fintype.card (TU N0) + Fintype.card (TU N0) * (dB + Δ) := by positivity
    linarith
  let E : Tok κ → Finset (Sym2 (TU N0)) := fun τ => if τ.sign then plusE P else minusE P
  have hEloop : ∀ τ ∈ S, ∀ e ∈ E τ, ¬ e.IsDiag := by
    intro τ _ e he
    simp only [E] at he
    split_ifs at he
    · exact plus_loopless hP e he
    · exact minus_loopless e he
  have hEeven : ∀ τ, ∀ w, Even (incidentLoad (E τ) w) := by
    intro τ w
    simp only [E]
    split_ifs
    · exact plus_even hP w
    · exact minus_even hP w
  have hEprop : ∀ τ ∈ S, ∀ x y, s(x, y) ∈ E τ →
      (fun i j => ∃ k, Link F i j k) (tlabel F P x) (tlabel F P y) := by
    intro τ _ x y hxy
    simp only [E] at hxy
    split_ifs at hxy
    · exact plus_allowed hP x y hxy
    · exact minus_allowed hP x y hxy
  have hEcard : ∀ τ ∈ S, (E τ).card ≤ 2 * m0 := by
    intro τ _
    simp only [E]
    split_ifs
    · exact (plus_card hP).trans (by omega)
    · exact minus_card hP
  have hcount' : 4 * ((2 * m0 : ℕ) : ℝ) * (S.card : ℝ) ≤ ((Δ : ℝ) - (2 * m0 : ℕ)) * a := by
    have h1 : (S.card : ℝ) ≤ Ncap := by exact_mod_cast hS
    have h2 : (0 : ℝ) ≤ 4 * ((2 * m0 : ℕ) : ℝ) := by positivity
    nlinarith
  have hbudget' : (Fintype.card (TU N0) : ℝ) + Fintype.card (TU N0) *
      (dB + ((Δ : ℝ) - (2 * m0 : ℕ)) + ((2 * m0 : ℕ) : ℝ)) < a / 2 := by
    have : dB + ((Δ : ℝ) - (2 * m0 : ℕ)) + ((2 * m0 : ℕ) : ℝ) = dB + Δ := by ring
    rw [this]; exact hbudget
  obtain ⟨f, hf⟩ := guarded_template_familyU p G (fun i j => ∃ k, Link F i j k) S E
    (fun _ => tlabel F P) (2 * m0) hEloop hEprop hEcard a dB _ hs B hB hdB hT hbudget' hcount'
  refine ⟨fun τ => mappedU (E τ) (f τ), ⟨hf.disjoint, hf.avoid, ?_, ?_, ?_, ?_⟩, hf.subgraph, ?_⟩
  · intro τ hτ
    exact loopless_image (VInjOn.of_injective (hf.injective τ hτ) _) (hEloop τ hτ)
  · intro τ hτ
    exact even_image (VInjOn.of_injective (hf.injective τ hτ) _) (hEeven τ)
  · intro τ hτ
    change edgeVal (chargeVal F p) ((E τ).image (Sym2.map (f τ))) = _
    rw [edgeVal_chargeVal, edgeVec_image (VInjOn.of_injective (hf.injective τ hτ) _)
      (fun _ _ u _ => hf.labels τ hτ u)]
    simp only [E]
    split_ifs
    · exact plus_charge P
    · exact minus_charge hP
  · intro τ hτ
    exact card_image_le.trans (hEcard τ hτ)
  · intro v
    have h := hf.incidence v
    have : ((Δ : ℝ) - (2 * m0 : ℕ)) + ((2 * m0 : ℕ) : ℝ) = Δ := by ring
    rw [this] at h
    exact_mod_cast h

end Supply

end PartitionedTriangleAbsorption.BlowupB.UniversalProducer
