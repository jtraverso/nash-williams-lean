@[expose] public section

/-!
# Parity vertex lattices: the exact local hypothesis of the charge reduction

For a root part `r` the *link graph* of `F` at `r` has vertex set `Fin t` and an edge `a – b`
(a loop when `a = b`) for every `Link F r a b`.  The vertex lattice at `r` is generated by the
vectors `basis a + basis b` of these edges.

`PairLattice F` says that for every root `r` and all active labels `a, b` (labels that occur in
some link at `r`) the vector `basis a + basis b` lies in the vertex lattice at `r`.
Equivalently (`pairLattice_iff`) the vertex lattice at every root is the full even-sum lattice on
the active labels.  Combinatorially it holds as soon as any two active labels are joined by a
walk of odd length in the link graph (`pairLattice_of_oddR`), and for card-three types this is
an equivalence (`pairLattice_iff_oddR`); `ThreeStepLinks` is the special
case of walks of length exactly three (`pairLattice_of_threeStepLinks`).

Under `PairLattice F`, an active, loopless, even edge set is integrally divisible exactly when its
global type charge vanishes (`isIntDiv_iff_charge_zero_pair`).  This is the only place where
the charge reduction used `ThreeStepLinks`.
-/

namespace PartitionedTriangleAbsorption.BlowupB.UniversalProducer

open Finset TypedTransformer TypedDivisibilityCollapse AntiEdgeSelection

variable {t : ℕ}

/-- **Parity vertex lattices.** For every root `r` and active labels `a, b` at `r`, the vector
`basis a + basis b` lies in the vertex lattice of `F` at `r`. -/
def PairLattice (F : Finset (Multiset (Fin t))) : Prop :=
  ∀ r a b : Fin t, (∃ c, Link F r a c) → (∃ c, Link F r b c) →
    basis a + basis b ∈ (latticeHom F r).range

/-- `ThreeStepLinks` implies `PairLattice`. -/
theorem pairLattice_of_threeStepLinks {F : Finset (Multiset (Fin t))} (h : ThreeStepLinks F) :
    PairLattice F :=
  fun _ _ _ ha hb => active_pair_mem h ha hb

/-- Under `PairLattice`, every even-sum vector supported on active labels lies in the vertex
lattice. -/
theorem mem_of_active_even_pair {F : Finset (Multiset (Fin t))} (hF : PairLattice F) {r : Fin t}
    (d : Fin t → ℤ) (hsupp : ∀ j, d j ≠ 0 → ∃ c, Link F r j c) (heven : Even (∑ j, d j)) :
    d ∈ (latticeHom F r).range := by
  by_cases h0 : ∃ a, ∃ c, Link F r a c
  · obtain ⟨a, ha⟩ := h0
    obtain ⟨m, hm⟩ := heven
    have hsum : (∑ j, d j • (basis j + basis a)) ∈ (latticeHom F r).range := by
      refine sum_mem fun j _ => ?_
      by_cases hj : d j = 0
      · rw [hj, zero_smul]; exact zero_mem _
      · exact zsmul_mem (hF r j a (hsupp j hj) ha) _
    have hsq : m • (basis a + basis a) ∈ (latticeHom F r).range :=
      zsmul_mem (hF r a a ha ha) _
    have e : d = (∑ j, d j • (basis j + basis a)) - m • (basis a + basis a) := by
      funext k
      simp only [Pi.sub_apply, Finset.sum_apply, Pi.smul_apply, Pi.add_apply, smul_eq_mul,
        mul_add, sum_add_distrib, ← sum_mul, hm]
      simp only [basis, mul_ite, mul_one, mul_zero, sum_ite_eq', mem_univ, ite_true]
      split_ifs <;> ring
    rw [e]
    exact sub_mem hsum hsq
  · push_neg at h0
    have : d = 0 := by
      funext j
      by_contra hj
      obtain ⟨c, hc⟩ := hsupp j hj
      exact h0 j c hc
    rw [this]
    exact zero_mem _

/-- **Characterisation.** `PairLattice F` holds exactly when, at every root, the vertex lattice
contains every even-sum vector supported on active labels. -/
theorem pairLattice_iff (F : Finset (Multiset (Fin t))) :
    PairLattice F ↔ ∀ (r : Fin t) (d : Fin t → ℤ), (∀ j, d j ≠ 0 → ∃ c, Link F r j c) →
      Even (∑ j, d j) → d ∈ (latticeHom F r).range := by
  constructor
  · intro h r d hs he
    exact mem_of_active_even_pair h d hs he
  · intro h r a b ha hb
    apply h r
    · intro j hj
      by_cases hja : a = j
      · subst hja; exact ha
      · by_cases hjb : b = j
        · subst hjb; exact hb
        · exact absurd (by simp [basis, hja, hjb]) hj
    · refine ⟨1, ?_⟩
      simp [basis, sum_add_distrib]

/-- Integral divisibility of an active, loopless, even edge set under `PairLattice`. -/
theorem isIntDiv_of_active_even_pair {V : Type*} [DecidableEq V] {p : V → Fin t}
    {F : Finset (Multiset (Fin t))} (hF : PairLattice F) {E : Finset (Sym2 V)}
    (hloop : ∀ e ∈ E, ¬ e.IsDiag) (hact : ActiveEdges F p E)
    (heven : ∀ v, Even (incidentLoad E v))
    (hedge : ∃ c : Multiset (Fin t) → ℤ, edgeVec p E = ∑ τ ∈ F, c τ • typeEdgeVec τ) :
    IsIntDiv p F E := by
  refine ⟨hedge, fun v => ?_⟩
  rw [← mem_range_latticeHom]
  apply mem_of_active_even_pair hF
  · intro j hj
    obtain ⟨b, hb, rfl⟩ := exists_of_degVec_ne_zero hj
    exact hact v b hb
  · rw [sum_degVec p E hloop v]
    obtain ⟨m, hm⟩ := heven v
    exact ⟨m, by rw [hm]; push_cast; ring⟩

/-- **Charge criterion under `PairLattice`.** -/
theorem isIntDiv_iff_charge_zero_pair {V : Type*} [DecidableEq V]
    (p : V → Fin t) (F : Finset (Multiset (Fin t)))
    (hF : PairLattice F) (E : Finset (Sym2 V))
    (hloop : ∀ e ∈ E, ¬ e.IsDiag) (hactive : ActiveEdges F p E)
    (heven : ∀ v, Even (incidentLoad E v)) :
    IsIntDiv p F E ↔ globalCharge F (edgeVec p E) = 0 := by
  rw [globalCharge_eq_zero_iff]
  exact ⟨fun h => h.1, fun h => isIntDiv_of_active_even_pair hF hloop hactive heven h⟩

/-! ### Odd walks in the link graph -/

instance decLink (F : Finset (Multiset (Fin t))) (r a b : Fin t) : Decidable (Link F r a b) := by
  unfold Link; infer_instance

theorem linkWalk_zero_iff {F : Finset (Multiset (Fin t))} {r a b : Fin t} :
    BlowupB.LinkWalk F r 0 a b ↔ a = b := by
  constructor
  · rintro ⟨⟩; rfl
  · rintro rfl; exact BlowupB.LinkWalk.nil a

theorem linkWalk_succ_iff {F : Finset (Multiset (Fin t))} {r a b : Fin t} {n : ℕ} :
    BlowupB.LinkWalk F r (n + 1) a b ↔ ∃ v, Link F r a v ∧ BlowupB.LinkWalk F r n v b := by
  constructor
  · rintro ⟨⟩
    rename_i v hl hw
    exact ⟨v, hl, hw⟩
  · rintro ⟨v, hl, hw⟩
    exact BlowupB.LinkWalk.cons hl hw

/-- Walks of a fixed length in a link graph are decidable. -/
instance decLinkWalk (F : Finset (Multiset (Fin t))) (r : Fin t) :
    ∀ n a b, Decidable (BlowupB.LinkWalk F r n a b)
  | 0, _, _ => decidable_of_iff _ linkWalk_zero_iff.symm
  | n + 1, a, b => by
    haveI := fun v => decLinkWalk F r n v b
    exact decidable_of_iff _ linkWalk_succ_iff.symm

/-- A walk of even length gives `basis a - basis b`, of odd length `basis a + basis b`. -/
theorem linkWalk_mem {F : Finset (Multiset (Fin t))} {r : Fin t} {n : ℕ} {a b : Fin t}
    (h : BlowupB.LinkWalk F r n a b) :
    (Even n → basis a - basis b ∈ (latticeHom F r).range) ∧
      (Odd n → basis a + basis b ∈ (latticeHom F r).range) := by
  induction h with
  | nil a => exact ⟨fun _ => by simp, fun ho => absurd ho (by decide)⟩
  | @cons n a v b hav _ ih =>
    have hl := link_mem hav
    refine ⟨fun he => ?_, fun ho => ?_⟩
    · have hn : Odd n := by
        rcases Nat.even_or_odd n with h | h
        · exact absurd he (by rw [Nat.even_add_one]; exact not_not.mpr h)
        · exact h
      have e : basis a - basis b = (basis a + basis v) - (basis v + basis b) := by abel
      rw [e]; exact sub_mem hl (ih.2 hn)
    · have hn : Even n := by
        rcases Nat.even_or_odd n with h | h
        · exact h
        · exact absurd ho (by rw [Nat.odd_add_one]; exact not_not.mpr h)
      have e : basis a + basis b = (basis a + basis v) - (basis v - basis b) := by abel
      rw [e]; exact sub_mem hl (ih.1 hn)

/-- An odd walk from `a` to `b` puts `basis a + basis b` in the vertex lattice. -/
theorem mem_of_oddR {F : Finset (Multiset (Fin t))} {r a b : Fin t} (h : BlowupB.OddR F r a b) :
    basis a + basis b ∈ (latticeHom F r).range := by
  obtain ⟨n, hw⟩ := h
  exact (linkWalk_mem hw).2 ⟨n, rfl⟩

/-- Conversely (card-three types), `basis a + basis b` in the vertex lattice forces an odd walk
from `a` to `b`. -/
theorem oddR_of_mem {F : Finset (Multiset (Fin t))} (hF3 : ∀ τ ∈ F, Multiset.card τ = 3)
    {r a b : Fin t} (h : basis a + basis b ∈ (latticeHom F r).range) : BlowupB.OddR F r a b := by
  classical
  obtain ⟨c, hc⟩ := mem_range_latticeHom.mp h
  have hpv : basis a + basis b = BlowupB.pairVecZ a b := by
    funext i; simp [basis, BlowupB.pairVecZ]
  rw [hpv] at hc
  have hbal := (BlowupB.balanced_of_lattice hF3 hc) a
  obtain ⟨h1, h2⟩ := hbal
  unfold BlowupB.evSum BlowupB.odSum at h1
  unfold BlowupB.compSum at h2
  rw [BlowupB.sum_filter_pairVecZ, BlowupB.sum_filter_pairVecZ] at h1
  rw [BlowupB.sum_filter_pairVecZ] at h2
  simp only [mem_filter, mem_univ, true_and] at h1 h2
  by_contra hab
  have hrefl : BlowupB.EvenR F r a a := BlowupB.evenR_refl a
  rw [if_pos hrefl, if_neg hab] at h1
  rw [if_pos (Or.inl hrefl)] at h2
  by_cases hev : BlowupB.EvenR F r a b
  · rw [if_pos hev] at h1
    split_ifs at h1 <;> omega
  · rw [if_neg (by tauto : ¬ (BlowupB.EvenR F r a b ∨ BlowupB.OddR F r a b))] at h2
    exact absurd h2 (by decide)

/-- **Combinatorial form of `PairLattice`** (card-three types): any two active labels at every
root are joined by an odd walk in the link graph. -/
theorem pairLattice_iff_oddR {F : Finset (Multiset (Fin t))}
    (hF3 : ∀ τ ∈ F, Multiset.card τ = 3) :
    PairLattice F ↔ ∀ r a b : Fin t, (∃ c, Link F r a c) → (∃ c, Link F r b c) →
      BlowupB.OddR F r a b :=
  ⟨fun h r a b ha hb => oddR_of_mem hF3 (h r a b ha hb),
    fun h r a b ha hb => mem_of_oddR (h r a b ha hb)⟩

/-- **Odd-walk criterion** (no cardinality hypothesis needed). -/
theorem pairLattice_of_oddR {F : Finset (Multiset (Fin t))}
    (h : ∀ r a b : Fin t, (∃ c, Link F r a c) → (∃ c, Link F r b c) → BlowupB.OddR F r a b) :
    PairLattice F :=
  fun r a b ha hb => mem_of_oddR (h r a b ha hb)

end PartitionedTriangleAbsorption.BlowupB.UniversalProducer

