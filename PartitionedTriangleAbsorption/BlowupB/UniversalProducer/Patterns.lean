import PartitionedTriangleAbsorption.BlowupB.UniversalProducer.EdgeMap
import PartitionedTriangleAbsorption.BlowupB.UniversalProducer.IterLayers
import PartitionedTriangleAbsorption.ReturnedDivisibility

/-!
# Patterns: a fixed finite catalogue of physical charge tokens

A *pattern* is a part-labelled loopless even edge set on `Fin N0` with at most `m0` edges
all of whose edges are active.  There are finitely many patterns; they are fixed by
`F, m0, N0` only, i.e. BEFORE any host.  Their charges in the integral type quotient
`TypeChargeGroup F` form the generator list `genList F m0 N0`.

* Every bounded loopless even active edge set of any host has the charge of a pattern
  (`charge_mem_closure_genList`), so preliminary pieces have charges in the subgroup
  generated by `genList`.
* Every pattern `P` gives two templates on `TU N0 = Fin N0 ⊕ Sym2 (Fin N0)`: the *plus*
  template (a copy of `P`, charge `+[P]`) and the *minus* template (every edge `ab` of `P`
  replaced by a path `a x_e b` through a new vertex labelled by the third part of an
  allowed triangle type through `ab`; charge `[P]·(-1)` because each triangle type has
  charge `0`).  Both are loopless and even, with allowed edges, so they can be embedded
  by the guarded supply.
-/

namespace PartitionedTriangleAbsorption.BlowupB.UniversalProducer

open Finset PartitionedTriangleAbsorption PartitionedTriangleAbsorption.AntiEdgeSelection
open PartitionedTriangleAbsorption.StructuralF3General PartitionedTriangleAbsorption.TypedTransformer

variable {t : ℕ}

/-- A pattern: a labelling of `Fin N0` and an edge set. -/
abbrev Pat (t N0 : ℕ) := (Fin N0 → Fin t) × Finset (Sym2 (Fin N0))

/-- Admissible patterns. -/
def PatOK (F : Finset (Multiset (Fin t))) (m0 : ℕ) {N0 : ℕ} (P : Pat t N0) : Prop :=
  (∀ e ∈ P.2, ¬ e.IsDiag) ∧ (∀ k, Even (incidentLoad P.2 k)) ∧
    (∀ a b, s(a, b) ∈ P.2 → ∃ c, Link F (P.1 a) (P.1 b) c) ∧ P.2.card ≤ m0

/-- The finite catalogue of admissible patterns. -/
noncomputable def patterns (F : Finset (Multiset (Fin t))) (m0 N0 : ℕ) : Finset (Pat t N0) := by
  classical exact univ.filter (PatOK F m0)

theorem mem_patterns {F : Finset (Multiset (Fin t))} {m0 N0 : ℕ} {P : Pat t N0} :
    P ∈ patterns F m0 N0 ↔ PatOK F m0 P := by
  classical
  simp [patterns]

/-- The charge of a pattern. -/
noncomputable def patCharge (F : Finset (Multiset (Fin t))) {N0 : ℕ} (P : Pat t N0) :
    TypeChargeGroup F :=
  globalCharge F (edgeVec P.1 P.2)

/-- The generator list. -/
noncomputable def genList (F : Finset (Multiset (Fin t))) (m0 N0 : ℕ) : List (TypeChargeGroup F) :=
  (patterns F m0 N0).toList.map (patCharge F)

theorem exists_pattern_of_mem_genList {F : Finset (Multiset (Fin t))} {m0 N0 : ℕ}
    {g : TypeChargeGroup F} (hg : g ∈ genList F m0 N0) :
    ∃ P ∈ patterns F m0 N0, patCharge F P = g := by
  obtain ⟨P, hP, rfl⟩ := List.mem_map.mp hg
  exact ⟨P, mem_toList.mp hP, rfl⟩

/-- The template vertex type. -/
abbrev TU (N0 : ℕ) := Fin N0 ⊕ Sym2 (Fin N0)

/-- Ends of an unordered pair. -/
noncomputable def ea {α : Type*} (e : Sym2 α) : α := (Quot.out e).1
noncomputable def eb {α : Type*} (e : Sym2 α) : α := (Quot.out e).2

theorem mk_ea_eb {α : Type*} (e : Sym2 α) : s(ea e, eb e) = e := Quot.out_eq e

/-- The third part of an allowed triangle type through the pair `e`. -/
noncomputable def third (F : Finset (Multiset (Fin t))) {N0 : ℕ} (ℓ : Fin N0 → Fin t)
    (e : Sym2 (Fin N0)) : Fin t :=
  open Classical in
  if h : ∃ c, Link F (ℓ (ea e)) (ℓ (eb e)) c then Classical.choose h else ℓ (ea e)

/-- Template labels. -/
noncomputable def tlabel (F : Finset (Multiset (Fin t))) {N0 : ℕ} (P : Pat t N0) :
    TU N0 → Fin t :=
  Sum.elim P.1 (third F P.1)

/-- The plus template. -/
def plusE {N0 : ℕ} (P : Pat t N0) : Finset (Sym2 (TU N0)) := P.2.image (Sym2.map Sum.inl)

/-- The path replacing one edge. -/
noncomputable def pathE {N0 : ℕ} (e : Sym2 (Fin N0)) : Finset (Sym2 (TU N0)) :=
  {s(Sum.inl (ea e), Sum.inr e), s(Sum.inr e, Sum.inl (eb e))}

/-- The minus template. -/
noncomputable def minusE {N0 : ℕ} (P : Pat t N0) : Finset (Sym2 (TU N0)) := P.2.biUnion pathE

theorem allowed_symm {F : Finset (Multiset (Fin t))} {i j : Fin t}
    (h : ∃ c, Link F i j c) : ∃ c, Link F j i c := by
  obtain ⟨c, hc⟩ := h
  exact ⟨c, (link_root_swap F i j c).mp hc⟩

section Plus

variable {F : Finset (Multiset (Fin t))} {m0 N0 : ℕ} {P : Pat t N0}

theorem plus_loopless (hP : PatOK F m0 P) : ∀ e ∈ plusE P, ¬ e.IsDiag :=
  loopless_image (VInjOn.of_injective Sum.inl_injective _) hP.1

theorem plus_even (hP : PatOK F m0 P) : ∀ w, Even (incidentLoad (plusE P) w) :=
  even_image (VInjOn.of_injective Sum.inl_injective _) hP.2.1

theorem plus_card (hP : PatOK F m0 P) : (plusE P).card ≤ m0 :=
  card_image_le.trans hP.2.2.2

theorem plus_allowed (hP : PatOK F m0 P) :
    ∀ x y, s(x, y) ∈ plusE P → ∃ c, Link F (tlabel F P x) (tlabel F P y) c := by
  intro x y hxy
  obtain ⟨e, he, hee⟩ := mem_image.mp hxy
  induction e using Sym2.ind with
  | _ a b =>
    rw [Sym2.map_mk] at hee
    rcases Sym2.eq_iff.mp hee with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact hP.2.2.1 a b he
    · exact allowed_symm (hP.2.2.1 a b he)

theorem plus_charge (P : Pat t N0) :
    globalCharge F (edgeVec (tlabel F P) (plusE P)) = patCharge F P := by
  unfold patCharge plusE
  rw [edgeVec_image (VInjOn.of_injective Sum.inl_injective _) (fun _ _ _ _ => rfl)]
  rfl

end Plus

section Minus

variable {F : Finset (Multiset (Fin t))} {m0 N0 : ℕ} {P : Pat t N0}

theorem ea_ne_eb {N : ℕ} {e : Sym2 (Fin N)} (he : ¬ e.IsDiag) : ea e ≠ eb e := by
  intro h
  apply he
  rw [← mk_ea_eb e, h]
  exact Sym2.mk_isDiag_iff.mpr rfl

theorem pathE_loopless (e : Sym2 (Fin N0)) : ∀ x ∈ pathE e, ¬ (x : Sym2 (TU N0)).IsDiag := by
  intro x hx
  simp only [pathE, mem_insert, mem_singleton] at hx
  rcases hx with rfl | rfl <;> simp

theorem pathE_disjoint {e e' : Sym2 (Fin N0)} (hne : e ≠ e') :
    Disjoint (pathE e : Finset (Sym2 (TU N0))) (pathE e') := by
  rw [disjoint_left]
  intro x hx hx'
  simp only [pathE, mem_insert, mem_singleton] at hx hx'
  rcases hx with rfl | rfl <;> rcases hx' with h | h <;>
    rcases Sym2.eq_iff.mp h with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> simp_all

theorem pathE_ne (e : Sym2 (Fin N0)) (he : ¬ e.IsDiag) :
    (s(Sum.inl (ea e), Sum.inr e) : Sym2 (TU N0)) ≠ s(Sum.inr e, Sum.inl (eb e)) := by
  intro h
  rcases Sym2.eq_iff.mp h with ⟨h1, _⟩ | ⟨h1, _⟩
  · simp at h1
  · exact ea_ne_eb he (Sum.inl_injective h1)

theorem minus_loopless : ∀ x ∈ minusE P, ¬ x.IsDiag := by
  intro x hx
  obtain ⟨e, -, hx⟩ := mem_biUnion.mp hx
  exact pathE_loopless e x hx

theorem minus_card (hP : PatOK F m0 P) : (minusE P).card ≤ 2 * m0 := by
  refine card_biUnion_le.trans ?_
  calc ∑ e ∈ P.2, (pathE e : Finset (Sym2 (TU N0))).card ≤ ∑ _e ∈ P.2, 2 :=
        sum_le_sum fun e _ => card_le_two
    _ = 2 * P.2.card := by rw [sum_const, smul_eq_mul, mul_comm]
    _ ≤ 2 * m0 := Nat.mul_le_mul_left 2 hP.2.2.2

theorem third_spec {ℓ : Fin N0 → Fin t} {e : Sym2 (Fin N0)}
    (h : ∃ c, Link F (ℓ (ea e)) (ℓ (eb e)) c) : Link F (ℓ (ea e)) (ℓ (eb e)) (third F ℓ e) := by
  classical
  unfold third
  rw [dif_pos h]
  exact Classical.choose_spec h

theorem active_ea_eb (hP : PatOK F m0 P) {e : Sym2 (Fin N0)} (he : e ∈ P.2) :
    ∃ c, Link F (P.1 (ea e)) (P.1 (eb e)) c :=
  hP.2.2.1 _ _ (by rw [mk_ea_eb]; exact he)

theorem minus_allowed (hP : PatOK F m0 P) :
    ∀ x y, s(x, y) ∈ minusE P → ∃ c, Link F (tlabel F P x) (tlabel F P y) c := by
  intro x y hxy
  obtain ⟨e, he, hxy⟩ := mem_biUnion.mp hxy
  have hl := third_spec (active_ea_eb hP he)
  set a := P.1 (ea e)
  set b := P.1 (eb e)
  set z := third F P.1 e
  have h1 : ∃ c, Link F a z c := ⟨b, (link_swap F a b z).mp hl⟩
  have h2 : ∃ c, Link F z b c := ⟨a, (link_swap F z a b).mp
    ((link_root_swap F a z b).mp ((link_swap F a b z).mp hl))⟩
  simp only [pathE, mem_insert, mem_singleton] at hxy
  rcases hxy with h | h <;> rcases Sym2.eq_iff.mp h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact h1
  · exact allowed_symm h1
  · exact h2
  · exact allowed_symm h2

theorem pairwiseDisjoint_pathE (s : Finset (Sym2 (Fin N0))) :
    (s : Set (Sym2 (Fin N0))).PairwiseDisjoint (pathE : Sym2 (Fin N0) → Finset (Sym2 (TU N0))) :=
  fun _ _ _ _ hne => pathE_disjoint hne

theorem incidentLoad_biUnion_disj {V ι : Type*} [DecidableEq V] (s : Finset ι)
    (E : ι → Finset (Sym2 V)) (h : (s : Set ι).PairwiseDisjoint E) (v : V) :
    incidentLoad (s.biUnion E) v = ∑ i ∈ s, incidentLoad (E i) v := by
  unfold incidentLoad
  rw [filter_biUnion, card_biUnion]
  intro i hi j hj hij
  exact disjoint_filter_filter (h hi hj hij)

theorem incidentLoad_pathE_inl {e : Sym2 (Fin N0)} (he : ¬ e.IsDiag) (a : Fin N0) :
    incidentLoad (pathE e : Finset (Sym2 (TU N0))) (Sum.inl a) = if a ∈ e then 1 else 0 := by
  classical
  have hne := pathE_ne e he
  have hab := ea_ne_eb he
  have hmem : a ∈ e ↔ a = ea e ∨ a = eb e := by
    conv_lhs => rw [← mk_ea_eb e]
    exact Sym2.mem_iff
  unfold incidentLoad pathE
  rw [filter_insert, filter_singleton]
  by_cases h1 : a = ea e
  · have h2 : a ≠ eb e := fun h => hab (h1 ▸ h)
    subst h1
    simp [h2, hmem]
  · by_cases h2 : a = eb e
    · subst h2
      simp [h1, hmem]
    · simp [h1, h2, hmem]

theorem incidentLoad_pathE_inr (e e' : Sym2 (Fin N0)) (he : ¬ e.IsDiag) :
    incidentLoad (pathE e : Finset (Sym2 (TU N0))) (Sum.inr e') = if e = e' then 2 else 0 := by
  classical
  have hne := pathE_ne e he
  unfold incidentLoad pathE
  rw [filter_insert, filter_singleton]
  by_cases h : e = e'
  · subst h
    simp [hne]
  · simp [h, Ne.symm h]

theorem minus_even (hP : PatOK F m0 P) : ∀ w, Even (incidentLoad (minusE P) w) := by
  classical
  intro w
  unfold minusE
  rw [incidentLoad_biUnion_disj _ _ (pairwiseDisjoint_pathE P.2)]
  rcases w with a | e'
  · rw [sum_congr rfl fun e he => incidentLoad_pathE_inl (hP.1 e he) a]
    have : ∑ e ∈ P.2, (if a ∈ e then 1 else 0) = incidentLoad P.2 a := by
      rw [sum_boole]; rfl
    rw [this]
    exact hP.2.1 a
  · rw [sum_congr rfl fun e he => incidentLoad_pathE_inr e e' (hP.1 e he)]
    rw [sum_ite_eq' P.2 e']
    split_ifs
    · exact ⟨1, rfl⟩
    · exact ⟨0, rfl⟩

theorem pathE_vec (e : Sym2 (Fin N0)) (he : ¬ e.IsDiag) :
    edgeVec (tlabel F P) (pathE e) + pairVec P.1 e =
      typeEdgeVec ({P.1 (ea e), P.1 (eb e), third F P.1 e} : Multiset (Fin t)) := by
  unfold edgeVec pathE
  rw [sum_pair (pathE_ne e he)]
  have hpe : pairVec P.1 e = pairVec P.1 s(ea e, eb e) := by rw [mk_ea_eb]
  rw [hpe]
  funext i j
  rw [typeEdgeVec_three]
  simp only [pairVec, Sym2.lift_mk, Pi.add_apply, tlabel, Sum.elim_inl, Sum.elim_inr]
  simp only [add_assoc, add_left_comm, add_comm]
  rfl

theorem minus_charge (hP : PatOK F m0 P) :
    globalCharge F (edgeVec (tlabel F P) (minusE P)) = -patCharge F P := by
  unfold minusE patCharge
  have h1 : edgeVec (tlabel F P) (P.2.biUnion pathE) =
      ∑ e ∈ P.2, edgeVec (tlabel F P) (pathE e) := by
    unfold edgeVec
    rw [sum_biUnion (pairwiseDisjoint_pathE P.2)]
  have h2 : ∀ e ∈ P.2, globalCharge F (edgeVec (tlabel F P) (pathE e)) =
      -globalCharge F (pairVec P.1 e) := by
    intro e he
    have h3 := congrArg (globalCharge F) (pathE_vec (F := F) (P := P) e (hP.1 e he))
    rw [map_add, globalCharge_typeEdgeVec (third_spec (active_ea_eb hP he))] at h3
    exact eq_neg_of_add_eq_zero_left h3
  rw [h1, map_sum, sum_congr rfl h2, sum_neg_distrib]
  unfold edgeVec
  rw [map_sum]

end Minus

end PartitionedTriangleAbsorption.BlowupB.UniversalProducer
