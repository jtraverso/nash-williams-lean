module

public import PartitionedTriangleAbsorption.ReturnedDivisibility
public import Mathlib.Algebra.Module.BigOperators

/-! # BlowupB.Defs — physical (lattice) divisibility for arbitrary families of partitioned triangles

New module of the "Theorem B (blowup)" route. It only adds files; nothing in the existing tree is
modified.

The aggregate divisibility `IsIntDiv` (Definition 13.5) only sees the edge-count vector and the
degree vectors. The absorber machinery needs the stronger **physical** condition: the indicator of
the edge set is an integer combination of indicators of *actual* `F`-copies of `G`.

* `PhysCert p F G E T c` — copies `T j` of `F` in `G` and coefficients `c j` with
  `ind E = ∑ j, c j · ind (E(T j))` at every edge coordinate;
* `PhysDiv`, `PhysDivCost` — existence of a certificate, of cost `∑ |c j|` at most `w`;
* `physCert_of_isDecomp` — a decomposition is a certificate with unit coefficients;
* `isIntDiv_of_physCert` — physical ⇒ aggregate. The converse, on nearly complete blowups, is
  the per-family certificate lemma (`class_lattice_certificate` for `F3`), to be generalized in
  later modules of this route.
-/

@[expose] public section

namespace PartitionedTriangleAbsorption.BlowupB

open Finset

variable {V : Type*} [Fintype V] [DecidableEq V] {t : ℕ}

/-- Integer indicator of an edge set. -/
def indZ (E : Finset (Sym2 V)) (e : Sym2 V) : ℤ := if e ∈ E then 1 else 0

omit [Fintype V] in
theorem indZ_mem {E : Finset (Sym2 V)} {e : Sym2 V} (h : e ∈ E) : indZ E e = 1 := by
  simp [indZ, h]

omit [Fintype V] in
theorem indZ_not_mem {E : Finset (Sym2 V)} {e : Sym2 V} (h : e ∉ E) : indZ E e = 0 := by
  simp [indZ, h]

/-- **Physical signed certificate** for `E`: actual `F`-copies `T j` of `G` with integer
coefficients `c j` whose signed edge-indicator sum is the indicator of `E`, at every edge. -/
def PhysCert (p : V → Fin t) (F : Finset (Multiset (Fin t))) (G : SimpleGraph V)
    (E : Finset (Sym2 V)) {ι : Type*} [Fintype ι] (T : ι → Finset V) (c : ι → ℤ) : Prop :=
  (∀ j, IsCopy p F G (T j)) ∧ ∀ e, indZ E e = ∑ j, c j * indZ (triEdges (T j)) e

/-- `E` lies in the physical lattice generated by the `F`-copies of `G`. -/
def PhysDiv (p : V → Fin t) (F : Finset (Multiset (Fin t))) (G : SimpleGraph V)
    (E : Finset (Sym2 V)) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι) (T : ι → Finset V) (c : ι → ℤ), PhysCert p F G E T c

/-- `E` has a physical certificate of cost `∑ |c j|` at most `w`. -/
def PhysDivCost (p : V → Fin t) (F : Finset (Multiset (Fin t))) (G : SimpleGraph V)
    (E : Finset (Sym2 V)) (w : ℤ) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι) (T : ι → Finset V) (c : ι → ℤ),
    PhysCert p F G E T c ∧ ∑ j, |c j| ≤ w

/-! ### Decompositions are certificates -/

/-- A decomposition of `E ⊆ E(G)` into typed triangles is a physical certificate with all
coefficients equal to `1`. -/
theorem physCert_of_isDecomp {p : V → Fin t} {F : Finset (Multiset (Fin t))}
    {G : SimpleGraph V} [DecidableRel G.Adj] {E : Finset (Sym2 V)} (hE : E ⊆ G.edgeFinset)
    {D : Finset (Finset V)} (hD : IsDecomp p F E D) :
    PhysCert p F G E (fun s : D => (s : Finset V)) (fun _ => 1) := by
  obtain ⟨hT, hdisj, hU⟩ := hD
  refine ⟨fun s => ?_, fun e => ?_⟩
  · have hs := hT s s.2
    refine ⟨?_, hs.2⟩
    rw [SimpleGraph.isNClique_iff]
    refine ⟨fun x hx y hy hxy => ?_, hs.1⟩
    have hmem : s(x, y) ∈ triEdges (s : Finset V) := by
      refine mem_filter.mpr ⟨mem_sym2_iff.mpr ?_, ?_⟩
      · intro a ha
        rcases Sym2.mem_iff.mp ha with rfl | rfl
        · exact hx
        · exact hy
      · rw [Sym2.mk_isDiag_iff]; exact hxy
    have hE' : s(x, y) ∈ E := by
      rw [← hU]; exact mem_biUnion.mpr ⟨s, s.2, hmem⟩
    exact SimpleGraph.mem_edgeFinset.mp (hE hE')
  · simp only [one_mul]
    by_cases he : e ∈ E
    · rw [indZ_mem he]
      have he' := he
      rw [← hU] at he'
      obtain ⟨s₀, hs₀, hes₀⟩ := mem_biUnion.mp he'
      rw [Finset.sum_eq_single (⟨s₀, hs₀⟩ : D)]
      · exact (indZ_mem hes₀).symm
      · intro s _ hne
        apply indZ_not_mem
        intro hes
        have hd : Disjoint (triEdges (s : Finset V)) (triEdges s₀) :=
          hdisj s.2 hs₀ (fun h => hne (Subtype.ext h))
        exact Finset.disjoint_left.mp hd hes hes₀
      · intro h; exact absurd (mem_univ _) h
    · rw [indZ_not_mem he]
      symm
      apply Finset.sum_eq_zero
      intro s _
      apply indZ_not_mem
      intro hes
      exact he (hU ▸ mem_biUnion.mpr ⟨s, s.2, hes⟩)

/-! ### Physical ⇒ aggregate -/

/-- The edge-count vector as a weighted sum over all coordinates. -/
theorem edgeVec_eq_sum_indZ (p : V → Fin t) (E : Finset (Sym2 V)) :
    edgeVec p E = ∑ e, indZ E e • pairVec p e := by
  unfold edgeVec
  simp only [indZ, ite_smul, one_smul, zero_smul, Finset.sum_ite_mem, univ_inter]

/-- The degree vector as a weighted sum over all coordinates. -/
theorem degVec_eq_sum_indZ (p : V → Fin t) (E : Finset (Sym2 V)) (v : V) :
    degVec p E v = ∑ e, indZ E e • degContrib p v e := by
  unfold degVec
  simp only [indZ, ite_smul, one_smul, zero_smul, Finset.sum_ite_mem, univ_inter]

/-- A physical certificate yields the aggregate divisibility of Definition 13.5. -/
theorem isIntDiv_of_physCert {p : V → Fin t} {F : Finset (Multiset (Fin t))}
    {G : SimpleGraph V} {E : Finset (Sym2 V)} {ι : Type*} [Fintype ι] {T : ι → Finset V}
    {c : ι → ℤ} (h : PhysCert p F G E T c) : IsIntDiv p F E := by
  obtain ⟨hcopy, hid⟩ := h
  have hcard : ∀ j, (T j).card = 3 := fun j => (hcopy j).1.card_eq
  have hmem : ∀ j, triType p (T j) ∈ F := fun j => (hcopy j).2
  have hE : edgeVec p E = ∑ j, c j • typeEdgeVec (triType p (T j)) := by
    rw [edgeVec_eq_sum_indZ]
    simp_rw [hid, Finset.sum_smul, mul_smul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← Finset.smul_sum, ← edgeVec_eq_sum_indZ, edgeVec_triEdges p (hcard j)]
  refine ⟨⟨fun τ => ∑ j ∈ univ.filter (fun j => triType p (T j) = τ), c j, ?_⟩, fun v => ?_⟩
  · rw [hE, ← Finset.sum_fiberwise_of_maps_to (g := fun j => triType p (T j)) (t := F)
      (fun j _ => hmem j)]
    refine Finset.sum_congr rfl fun τ _ => ?_
    rw [Finset.sum_smul]
    exact Finset.sum_congr rfl fun j hj => by rw [(mem_filter.mp hj).2]
  · have hD : degVec p E v = ∑ j, c j • degVec p (triEdges (T j)) v := by
      rw [degVec_eq_sum_indZ]
      simp_rw [hid, Finset.sum_smul, mul_smul]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun j _ => by rw [← Finset.smul_sum, ← degVec_eq_sum_indZ]
    refine ⟨fun τ => ∑ j ∈ univ.filter (fun j => v ∈ T j ∧ triType p (T j) = τ), c j, ?_⟩
    rw [hD]
    simp_rw [degVec_triEdges p (hcard _) v]
    rw [← Finset.sum_filter_add_sum_filter_not univ (fun j => v ∈ T j)]
    rw [Finset.sum_eq_zero (s := univ.filter (fun j => ¬ v ∈ T j))
      (fun j hj => by rw [if_neg (mem_filter.mp hj).2, smul_zero]), add_zero]
    rw [← Finset.sum_fiberwise_of_maps_to (g := fun j => triType p (T j))
      (t := F.filter (p v ∈ ·))
      (fun j hj => mem_filter.mpr ⟨hmem j, mem_triType (mem_filter.mp hj).2⟩)]
    refine Finset.sum_congr rfl fun τ _ => ?_
    rw [Finset.sum_smul, filter_filter]
    refine Finset.sum_congr rfl fun j hj => ?_
    obtain ⟨hv, hτ⟩ := (mem_filter.mp hj).2
    rw [if_pos hv, hτ]

/-- Physical lattice membership implies aggregate divisibility. -/
theorem isIntDiv_of_physDiv {p : V → Fin t} {F : Finset (Multiset (Fin t))} {G : SimpleGraph V}
    {E : Finset (Sym2 V)} (h : PhysDiv p F G E) : IsIntDiv p F E := by
  obtain ⟨ι, _, T, c, hc⟩ := h
  exact isIntDiv_of_physCert hc

end PartitionedTriangleAbsorption.BlowupB
